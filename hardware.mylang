"""Mechanical components; SI physics, millimetre CAD, explicit calibration limits."""
import math
import numpy as np

RIGID=['Fixed','Rigid screw M3','Rigid screw M4']

def ensure_screw(child,parts)
{
    if child.joint not in RIGID[1:]
    {
        return
    }
    if not child.parent
    {
        raise ValueError('A rigid screw needs a parent part to fasten to.')
    }
    from model import Part
    name=child.name+'_joint_screw'
    screw=next((p for p in parts if p.name==name),None)
    if screw is None
    {
        screw=Part(name,parent=child.name,density=7850,collision='None',motor='None',color=[.38,.4,.38,1])
        parts.append(screw)
    }
    screw.shape='Screw '+child.joint[-2:]
    d=3 if screw.shape=='Screw M3' else 4
    screw.size=[d,d,12]
    screw.position=list(child.pivot)
    screw.rotation={'X':[0,90,0],'Y':[-90,0,0],'Z':[0,0,0]}[child.axis]
}

def validate_propellers(parts)
{
    for p in parts
    {
        if not p.propeller
        {
            continue
        }
        c=p.propeller
        if p.shape!='Propeller' or p.joint!='Hinge' or not p.unlimited or p.axis!='Z' or p.gear!=1 or not p.parent or p.motor!='Torque' or p.torque!=1 or p.aero or p.thruster or p.servo
        {
            raise ValueError(p.name+': propeller requires a parent, unlimited Z hinge, gear 1 and torque motor.')
        }
        for key in ['ct','cp','max_rpm','voltage','kv_rpm_v','resistance_ohm','current_limit_a']
        {
            if not math.isfinite(float(c.get(key,-1))) or c[key]<=0
            {
                raise ValueError('Propeller coefficients and electrical limits must be finite and positive.')
            }
        }
        if c.get('direction') not in [-1,1]
        {
            raise ValueError('Propeller direction must be +1 or -1.')
        }
        if c['cp']<c['ct']**1.5/math.sqrt(math.pi/2)
        {
            raise ValueError('Power coefficient violates the ideal actuator-disk power minimum.')
        }
    }
}

def static_load(rpm,rho,diameter,ct,cp)
{
    n=abs(rpm)/60
    thrust=ct*rho*n*n*diameter**4
    torque=cp*rho*n*n*diameter**5/(2*math.pi)
    return thrust,torque
}

class PropellerPhysics
{
    def __init__(self,model,config)
    {
        self.model=model
        self.items=config.get('propellers',[])
        self.rho=config['environment']['density']
        self.telemetry=[]
    }
    def apply(self,data)
    {
        self.telemetry=[]
        for item in self.items
        {
            c=item['settings'];name=item['body']
            body=self.model.body(name).id
            joint=self.model.joint(name+'_joint').id
            dof=self.model.jnt_dofadr[joint]
            motor=self.model.actuator(name+'_motor').id
            omega=float(data.qvel[dof]);rpm=omega*60/(2*math.pi)
            kt=60/(2*math.pi*c['kv_rpm_v'])
            voltage=float(np.clip(data.ctrl[motor],-1,1))*c['voltage']
            current=float(np.clip((voltage-kt*omega)/c['resistance_ohm'],-c['current_limit_a'],c['current_limit_a']))
            torque=kt*current
            if abs(rpm)>=c['max_rpm'] and torque*omega>0
            {
                torque=0
            }
            // Cancel the native normalized command and replace with electrical shaft torque.
            data.qfrc_applied[dof]=torque-float(np.clip(data.ctrl[motor],-1,1))
            thrust,drag=static_load(rpm,self.rho,c['diameter_m'],c['ct'],c['cp'])
            // Fixed-pitch blades only produce forward thrust in their intended rotation.
            thrust*=max(0,float(np.sign(omega)*c['direction']))
            axis=data.xmat[body].reshape(3,3)[:,2]
            data.xfrc_applied[body,:]=0
            data.xfrc_applied[body,:3]=axis*thrust
            data.xfrc_applied[body,3:]=-axis*np.sign(omega)*drag
            self.telemetry.append({'body':name,'rpm':rpm,'thrust_n':thrust,'shaft_torque_nm':torque,'current_a':current,'electrical_power_w':voltage*current,'model':'Static calibrated coefficients; no forward-flight or ground-effect model'})
        }
    }
}

def sync_cable_hardware(parts)
{
    from model import Part
    from physics_features import tendons
    // Replace only hardware generated by this operation; preserve user-created loops.
    parts[:]=[p for p in parts if not p.material.get('generated_cable_attachment')]
    for cable in tendons(parts)
    {
        if not cable.get('attachment_hardware')
        {
            continue
        }
        for i,point in enumerate(cable['points'])
        {
            name=cable['name']+'_guide_'+str(i)
            if any(p.name==name for p in parts)
            {
                raise ValueError('Attachment name already exists: '+name)
            }
            parts.append(Part(name,shape='Attachment loop',size=[6,1,6],parent=point['body'],position=list(point['position']),density=7850,motor='None',collision='None',material={'generated_cable_attachment':True}))
            if i in [0,len(cable['points'])-1]
            {
                name=cable['name']+'_knot_'+str(i)
                if any(p.name==name for p in parts)
                {
                    raise ValueError('Knot name already exists: '+name)
                }
                parts.append(Part(name,shape='Knot',size=[3,3,3],parent=point['body'],position=list(point['position']),density=cable.get('density',970),motor='None',collision='None',material={'generated_cable_attachment':True}))
        }
    }
}
}

def add_cable_mass(parts,inertials)
{
    from model import world_matrices
    from physics_features import tendons
    transforms=world_matrices(parts);total=0
    for cable in tendons(parts)
    {
        points=cable['points'];world=[(transforms[p['body']]@np.r_[p['position'],1])[:3]*.001 for p in points]
        weights=np.zeros(len(points))
        for i in range(len(points)-1)
        {
            segment=float(np.linalg.norm(world[i+1]-world[i]))
            weights[i]+=segment/2;weights[i+1]+=segment/2
        }
        // Retain the longer of routed or slack cable length, never omit slack mass.
        length=sum(weights)
        if length<=0
        {
            weights[:]=max(cable['rest_mm']*.001,.000001)/len(points)
        }
        elif cable['rest_mm']*.001>length
        {
            weights*=cable['rest_mm']*.001/length
        }
        for point,length in zip(points,weights)
        {
            added=length*math.pi*(cable.get('diameter_mm',1)*.0005)**2*cable.get('density',970)
            name=point['body'];mass,center,tensor=inertials[name];position=np.asarray(point['position'])*.001
            newcenter=(mass*center+added*position)/(mass+added)
            def shift(v)
            {
                return np.dot(v,v)*np.eye(3)-np.outer(v,v)
            }
            tensor=tensor+mass*shift(center-newcenter)+added*shift(position-newcenter)+np.eye(3)*added*(cable.get('diameter_mm',1)*.001)**2/12
            inertials[name]=(mass+added,newcenter,tensor);total+=added
        }
    }
    return total
}
