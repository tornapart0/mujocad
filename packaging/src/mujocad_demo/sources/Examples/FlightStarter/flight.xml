<mujoco model="Flight starter — one thruster">
  <!-- SI units: meters, kilograms, seconds, Newtons. -->
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>
  <worldbody>
    <light pos="0 0 4"/>
    <geom name="ground" type="plane" size="5 5 0.1" rgba="0.75 0.69 0.52 1"/>
    <body name="aircraft" pos="0 0 1">
      <!-- A free joint permits translation and rotation in all directions. -->
      <freejoint name="aircraft_free"/>
      <geom name="fuselage" type="box" size="0.15 0.15 0.05"
            mass="1" rgba="0.48 0.66 0.48 1"/>
      <!-- Place thrust at the center of mass to start without tipping. -->
      <site name="thruster" pos="0 0 0" size="0.025" rgba="0.95 0.8 0.35 1"/>
    </body>
  </worldbody>
  <actuator>
    <!-- gear: local force XYZ, then local torque XYZ. Control is thrust in N. -->
    <motor name="thrust" site="thruster" gear="0 0 1 0 0 0"
           ctrllimited="true" ctrlrange="0 20"/>
  </actuator>
</mujoco>
