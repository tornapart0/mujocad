// Canonical Tay’s Sensible Lang source. Python is generated at build time.
"""A goal wizard and responsive training controls for the Mac CAD editor."""
from pathlib import Path
from copy import deepcopy
import json, math, os, signal, uuid
from datetime import datetime
from zoneinfo import ZoneInfo
import numpy as np
from scipy.spatial.transform import Rotation
from PySide6 import QtWidgets as W, QtCore as C
from model import local_matrix
ROOT = Path(__file__).resolve().parent

def runtime(watch=False)
{
    from runtime_paths import training_runtime
    return training_runtime(ROOT,watch)

}
def process_environment()
{
    env = C.QProcessEnvironment.systemEnvironment()
    env.insert('PATH', '/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin:' + os.environ.get('PATH', ''))
    env.insert('OPENBLAS_NUM_THREADS', '1')
    env.insert('VECLIB_MAXIMUM_THREADS', '1')
    return env

}
class TargetPage(W.QWizardPage)

{
    def initializePage(self)
    {
        self.wizard().update_goal()

    }
    def isComplete(self)
    {
        return self.wizard().target_valid()

    }
}
class TrainingWizard(W.QWizard)

{
    def __init__(self, parts, parent=None)
    {
        super().__init__(parent)
        self.parts = deepcopy(parts)
        self.pose_fields = {}
        self.setWindowTitle('Create Training')
        self.resize(720, 670)
        self.setWizardStyle(W.QWizard.ModernStyle)
        self.setButtonText(W.QWizard.FinishButton, 'Create & train')
        self.goal_page = W.QWizardPage()
        self.goal_page.setTitle('1 · Choose what your robot should learn')
        layout = W.QVBoxLayout(self.goal_page)
        description = W.QLabel('The app builds the learning loop for you. Choose a goal and the motors it may control. Your CAD design is saved as a separate training snapshot.')
        description.setWordWrap(True)
        layout.addWidget(description)
        self.goal = W.QComboBox()
        self.goal.addItems(['Move joints to a pose', 'Move a part to a point', 'Take off from the ground and fly'])
        layout.addWidget(self.goal)
        layout.addWidget(W.QLabel('Motors the learner can control'))
        self.motors = W.QListWidget()
        layout.addWidget(self.motors, 1)
        self.aux_drivers = {}
        for p in parts
        {
            if p.joint in ['Hinge', 'Slide', 'Ball'] and p.motor != 'None'
            {
                item = W.QListWidgetItem(f'{p.name} · {p.motor} motor')
                item.setData(C.Qt.UserRole, p.name)
                item.setFlags(item.flags() | C.Qt.ItemIsUserCheckable)
                item.setCheckState(C.Qt.Checked)
                self.motors.addItem(item)
            }
        }
        from physics_features import tendons
        auxiliary = [(p.name + '_thruster', p.name + ' · Thruster', [p.name]) for p in parts if p.thruster]
        auxiliary += [(t['name'] + '_tendon_motor', t['name'] + ' · Tendon', [point['body'] for point in t['points']]) for t in tendons(parts) if t['mode'] != 'Passive spring']
        for actuator, label, drivers in auxiliary
        {
            key = '@act:' + actuator
            self.aux_drivers[key] = drivers
            item = W.QListWidgetItem(label)
            item.setData(C.Qt.UserRole, key)
            item.setFlags(item.flags() | C.Qt.ItemIsUserCheckable)
            item.setCheckState(C.Qt.Checked)
            self.motors.addItem(item)
        }
        self.validation = W.QLabel()
        self.validation.setWordWrap(True)
        layout.addWidget(self.validation)
        self.goal_page.isComplete = self.controls_valid
        self.goal.currentIndexChanged.connect(lambda: self.goal_page.completeChanged.emit())
        self.motors.itemChanged.connect(lambda: self.goal_page.completeChanged.emit())
        self.addPage(self.goal_page)
        self.target_page = TargetPage()
        self.target_page.setTitle('2 · Set the target')
        layout = W.QVBoxLayout(self.target_page)
        self.target_stack = W.QStackedWidget()
        layout.addWidget(self.target_stack, 1)
        pose = W.QWidget()
        pl = W.QVBoxLayout(pose)
        pl.addWidget(W.QLabel('Enter the joint positions you want the robot to reach and hold.'))
        scalars = [p for p in parts if p.joint in ['Hinge', 'Slide'] and p.motor != 'None']
        self.pose_fields = {}
        self.pose_table = W.QTableWidget(len(scalars), 3)
        self.pose_table.setHorizontalHeaderLabels(['Joint / part', 'Target', 'Units'])
        self.pose_table.horizontalHeader().setSectionResizeMode(W.QHeaderView.Stretch)
        for row, p in enumerate(scalars)
        {
            self.pose_table.setItem(row, 0, W.QTableWidgetItem(p.name))
            spin = W.QDoubleSpinBox()
            spin.setDecimals(2)
            spin.setRange(*([-36000, 36000] if p.unlimited and p.motor != 'Position' else p.limits))
            spin.setValue(p.control if p.motor == 'Position' and p.control else 30 if p.joint == 'Hinge' else 20)
            self.pose_fields[p.name] = spin
            self.pose_table.setCellWidget(row, 1, spin)
            self.pose_table.setItem(row, 2, W.QTableWidgetItem('degrees' if p.joint == 'Hinge' else 'mm'))
        }
        pl.addWidget(self.pose_table)
        self.target_stack.addWidget(pose)
        reach = W.QWidget()
        rl = W.QVBoxLayout(reach)
        label = W.QLabel('Move the selected part’s tip to a point in the scene. Targets use world coordinates in mm.')
        label.setWordWrap(True)
        rl.addWidget(label)
        form = W.QFormLayout()
        self.tip = W.QComboBox()
        self.tip.addItems([p.name for p in parts])
        moving = [p.name for p in parts if p.joint in ['Hinge', 'Slide', 'Ball']]
        self.tip.setCurrentText(moving[-1] if moving else parts[-1].name)
        form.addRow('Moving part', self.tip)
        self.xyz = []
        for axis in 'XYZ'
        {
            spin = W.QDoubleSpinBox()
            spin.setRange(-100000, 100000)
            spin.setDecimals(2)
            spin.setSuffix(' mm')
            self.xyz.append(spin)
            form.addRow(axis + ' target', spin)
        }
        rl.addLayout(form)
        suggest = W.QPushButton('Suggest a target from the joint pose')
        suggest.clicked.connect(self.suggest_target)
        rl.addWidget(suggest)
        note = W.QLabel('The suggestion uses the pose values on the other goal page. Choose a reachable point; closed-loop mechanisms and collisions can restrict motion.')
        note.setWordWrap(True)
        rl.addWidget(note)
        rl.addStretch()
        self.target_stack.addWidget(reach)
        flight_page=W.QWidget()
        flight_form=W.QFormLayout(flight_page)
        flight_note=W.QLabel('Ground is Z = 0; Y = 0 is the horizontal centre. Start on the landing pads with zero velocity. The servos learn a smooth gait across 1–3 Hz and 15–30 degree flap amplitude with 2 degrees of trim; their torque and speed limits still apply. Success requires lifting clear of the ground and staying airborne for at least 20 seconds; hops and falling from a raised start do not count. This remains an uncalibrated simulation.')
        if any(p.scenario.get('kind')=='CompactCrankOrnithopter' for p in self.parts)
        {
            flight_note.setText('Start at rest on the stage, Z = 0. Training adjusts the shared crank motor speed and tail angle. The rods drive the wings through physical loop constraints; passive wing flex is not independently powered. Motor torque and no-load speed limits apply. Success requires lift-off and 20 continuous seconds airborne. This prototype has uncalibrated aerodynamics and is not proven to fly.')
        }
        if any(p.scenario.get('confined') for p in self.parts)
        {
            flight_note.setText('Confined flight: take off from the landing pads with no runway or throw. Training controls the crank motor, left and right wing incidence, and tail. Success requires 20 seconds airborne within 25 cm of the launch centre, no more than 15 degrees of tilt and 10 cm of height variation. Ground drift is limited to 5 cm. These are test limits, not a claim that this prototype is ready to fly in a classroom.')
        }
        flight_note.setWordWrap(True)
        flight_form.addRow(flight_note)
        self.takeoff_height=W.QDoubleSpinBox()
        self.takeoff_height.setRange(50,1000)
        self.takeoff_height.setValue(100)
        self.takeoff_height.setSuffix(' mm above the resting body')
        flight_form.addRow('Lift-off clearance',self.takeoff_height)
        self.airborne_seconds=W.QDoubleSpinBox()
        self.airborne_seconds.setRange(20,60)
        self.airborne_seconds.setValue(20)
        self.airborne_seconds.setSuffix(' seconds')
        flight_form.addRow('Continuous airborne time',self.airborne_seconds)
        self.target_stack.addWidget(flight_page)
        self.angle_tolerance = W.QDoubleSpinBox()
        self.angle_tolerance.setRange(0.1, 45)
        self.angle_tolerance.setValue(5)
        self.angle_tolerance.setSuffix(' degrees')
        self.distance_tolerance = W.QDoubleSpinBox()
        self.distance_tolerance.setRange(0.1, 100)
        self.distance_tolerance.setValue(5)
        self.distance_tolerance.setSuffix(' mm')
        tolerance = W.QFormLayout()
        tolerance.addRow('Allowed angle error', self.angle_tolerance)
        tolerance.addRow('Allowed position error', self.distance_tolerance)
        layout.addLayout(tolerance)
        self.target_warning = W.QLabel()
        self.target_warning.setWordWrap(True)
        layout.addWidget(self.target_warning)
        self.addPage(self.target_page)
        run = W.QWizardPage()
        run.setTitle('3 · Choose how long to practice')
        form = W.QFormLayout(run)
        self.job_name = W.QLineEdit('My robot training')
        form.addRow('Training name', self.job_name)
        self.duration = W.QComboBox()
        self.duration.addItem('Quick try · 10,240 steps', 10240)
        self.duration.addItem('More practice · 51,200 steps', 51200)
        self.duration.addItem('Longer training · 204,800 steps', 204800)
        self.duration.setCurrentIndex(1)
        form.addRow('Practice time', self.duration)
        self.seconds = W.QDoubleSpinBox()
        self.seconds.setRange(1, 60)
        self.seconds.setValue(5)
        self.seconds.setSuffix(' seconds')
        form.addRow('Maximum time per attempt', self.seconds)
        self.randomize = W.QCheckBox('Vary the starting joints slightly between attempts')
        self.randomize.setChecked(True)
        form.addRow(self.randomize)
        note = W.QLabel('Training runs in the background on your Mac. You can stop and save, continue later, or watch the learned policy repeatedly. Longer training does not guarantee success; the app evaluates the result after each run.')
        note.setWordWrap(True)
        form.addRow(note)
        self.addPage(run)
        self.tip.currentTextChanged.connect(lambda: self.target_page.completeChanged.emit())
        self.airborne_seconds.valueChanged.connect(lambda: self.update_goal())
        if not self.pose_fields
        {
            self.goal.setCurrentIndex(1)
        }
        self.suggest_target()
        if any(p.scenario.get('kind') in ['GroundOrnithopter','CompactCrankOrnithopter'] for p in self.parts)
        {
            self.goal.setCurrentIndex(2)
            self.job_name.setText('Ornithopter ground takeoff')
            self.seconds.setValue(30)
            self.randomize.setText('Vary mass and supply voltage conservatively; always start at rest on the ground')
        }
        self.goal_page.completeChanged.emit()

    }
    def chosen_parts(self)
    {
        return [self.motors.item(i).data(C.Qt.UserRole) for i in range(self.motors.count()) if self.motors.item(i).checkState() == C.Qt.Checked]

    }
    def controls_valid(self)
    {
        names = self.chosen_parts()
        valid = bool(names)
        if self.goal.currentIndex() == 0
        {
            valid = valid and any((name in self.pose_fields for name in names))
        }
        if self.goal.currentIndex()==2
        {
            required={'right_wing_hinge','left_wing_hinge','right_wing_pitch','left_wing_pitch'}
            compact=next((p.scenario for p in self.parts if p.scenario.get('kind')=='CompactCrankOrnithopter'),None)
            if compact
            {
                required={compact['drive'],compact['tail'],*compact.get('incidence_motors',[])}
            }
            valid=required.issubset(set(names)) and any(p.joint=='Free' and not p.parent for p in self.parts) and sum(p.name.endswith('_ground_pad') for p in self.parts)>=3 and not any(p.thruster for p in self.parts)
            self.validation.setText('' if valid else 'Ground flight requires a free body, three landing pads, all wing-drive and tail/feather motors, and no thrusters.')
            return valid
        }
        self.validation.setText('' if valid else 'Choose at least one motor. Joint-pose goals need a hinge or slider motor.')
        return valid

    }
    def update_goal(self)
    {
        self.target_stack.setCurrentIndex(self.goal.currentIndex())
        self.angle_tolerance.setEnabled(self.goal.currentIndex() == 0)
        self.distance_tolerance.setEnabled(self.goal.currentIndex() == 1)
        if self.goal.currentIndex()==2
        {
            self.seconds.setMinimum(self.airborne_seconds.value()+4)
            self.seconds.setValue(max(30,self.seconds.value()))
        }
        else
        {
            self.seconds.setMinimum(1)
        }
        names = self.chosen_parts()
        for name, spin in self.pose_fields.items()
        {
            spin.setEnabled(name in names)
        }
        self.target_page.completeChanged.emit()

    }
    def target_valid(self)
    {
        if self.goal.currentIndex()==2
        {
            self.target_warning.setText('')
            return self.controls_valid() and self.seconds.value()>=self.airborne_seconds.value()+4
        }
        if self.goal.currentIndex() == 0
        {
            return self.controls_valid()
        }
        lookup = {p.name: p for p in self.parts}
        p = lookup[self.tip.currentText()]
        moving = False
        seen = set()
        chain = []
        while p
        {
            if p.name in seen
            {
                break
            }
            seen.add(p.name)
            chain.append(p)
            moving = moving or p.joint != 'Fixed'
            p = lookup.get(p.parent)
        }
        warning = ''
        if not moving
        {
            warning = 'This part is fixed to the world. Choose a part with a movable joint or floating parent.'
        }
        elif not any((p.name in self.chosen_parts() or any(p.name in self.aux_drivers.get(key, []) for key in self.chosen_parts()) for p in chain))
        {
            warning = 'The selected motors do not drive this part. Choose a motor in its parent chain.'
        }
        elif all((p.joint in ['Fixed', 'Hinge', 'Slide'] and (p.joint == 'Fixed' or p.name in self.chosen_parts()) for p in chain))
        {
            reference = self.tip_position({})
            movable_tip = False
            for part in chain
            {
                if part.name not in self.chosen_parts()
                {
                    continue
                }
                values = [-35.0, 35.0] if part.joint == 'Hinge' else [-20.0, 20.0]
                if not part.unlimited
                {
                    values += list(part.limits)
                }
                for value in values
                {
                    if not part.unlimited
                    {
                        value = float(np.clip(value, *part.limits))
                    }
                    if np.linalg.norm(self.tip_position({part.name: value}) - reference) > 1e-06
                    {
                        movable_tip = True
                        break
                    }
                }
                if movable_tip
                {
                    break
                }
            }
            if not movable_tip
            {
                warning = 'The chosen tip is on the hinge rotation axis: these motors cannot move it to a point. Use Move joints to a pose, or change the hinge axis/pivot so the tip moves.'
            }
        }
        self.target_warning.setText(warning)
        return not warning

    }
    def tip_position(self, values)
    {
        lookup = {p.name: p for p in self.parts}
        cache = {}

        def matrix(p)
        {
            if p.name in cache
            {
                return cache[p.name]
            }
            m = local_matrix(p)
            motion = np.eye(4)
            value = values.get(p.name, 0)
            axis = np.eye(3)['XYZ'.index(p.axis)]
            if p.joint == 'Hinge'
            {
                motion[:3, :3] = Rotation.from_rotvec(axis * math.radians(value)).as_matrix()
                pivot = np.asarray(p.pivot)
                motion[:3, 3] = pivot - motion[:3, :3] @ pivot
            }
            elif p.joint == 'Slide'
            {
                motion[:3, 3] = axis * value
            }
            m = m @ motion
            if p.parent
            {
                m = matrix(lookup[p.parent]) @ m
            }
            cache[p.name] = m
            return m
        }
        p = lookup[self.tip.currentText()]
        return (matrix(p) @ np.array([0, 0, p.size[2] / 2, 1]))[:3]

    }
    def suggest_target(self)
    {
        values = {name: spin.value() for name, spin in self.pose_fields.items() if name in self.chosen_parts()}
        target = self.tip_position(values)
        for spin, value in zip(self.xyz, target)
        {
            spin.setValue(float(value))

        }
    }
    def configuration(self)
    {
        names = self.chosen_parts()
        motors = []
        for p in self.parts
        {
            if p.name in names
            {
                motors.extend([f'{p.name}_motor_{i}' for i in range(3)] if p.joint == 'Ball' else [f'{p.name}_motor'])
            }
        }
        motors.extend([name[5:] for name in names if name.startswith('@act:')])
        targets = {p.name + '_joint': self.pose_fields[p.name].value() * (math.pi / 180 if p.joint == 'Hinge' else 0.001) for p in self.parts if p.name in names and p.name in self.pose_fields}
        return {'version': 1, 'name': self.job_name.text().strip() or 'Robot training', 'model': 'robot.xml', 'goal': ['pose','reach','ground_flight'][self.goal.currentIndex()], 'takeoff_height_mm':self.takeoff_height.value(), 'airborne_seconds':self.airborne_seconds.value(), 'motors': motors, 'joint_targets': targets, 'site': self.tip.currentText() + '_tip', 'target': [spin.value() * 0.001 for spin in self.xyz], 'angle_tolerance': self.angle_tolerance.value(), 'distance_tolerance_mm': self.distance_tolerance.value(), 'episode_seconds': self.seconds.value(), 'randomize_start': self.randomize.isChecked(), 'steps': self.duration.currentData()}

    }
    def accept(self)
    {
        if not self.controls_valid() or not self.target_valid()
        {
            return
        }
        super().accept()

    }
}
class TrainingPanel(W.QDialog)

{
    def __init__(self, folder, configuration, parent=None)
    {
        super().__init__(parent)
        self.folder = Path(folder)
        self.config = configuration
        self.setWindowTitle(configuration['name'])
        self.resize(640, 480)
        self.running = False
        self.stop_requested = False
        self.buffer = ''
        self.watchers = []
        layout = W.QVBoxLayout(self)
        title = W.QLabel('Robot training')
        title.setStyleSheet('font-size:20px;font-weight:600')
        layout.addWidget(title)
        self.state = W.QLabel('Preparing the robot snapshot…')
        self.state.setWordWrap(True)
        layout.addWidget(self.state)
        self.progress = W.QProgressBar()
        self.progress.setRange(0, configuration['steps'])
        self.progress.setFormat('Training budget: %p%')
        layout.addWidget(self.progress)
        self.metrics = W.QLabel('The result will be evaluated over 10 attempts.')
        self.metrics.setWordWrap(True)
        layout.addWidget(self.metrics)
        self.log = W.QPlainTextEdit()
        self.log.setReadOnly(True)
        self.log.setMaximumBlockCount(500)
        layout.addWidget(self.log, 1)
        row = W.QHBoxLayout()
        self.stop = W.QPushButton('Stop & save')
        self.stop.setEnabled(False)
        self.stop.clicked.connect(self.stop_training)
        row.addWidget(self.stop)
        self.resume = W.QPushButton('Continue training')
        self.resume.setEnabled(False)
        self.resume.clicked.connect(lambda: self.start(True))
        row.addWidget(self.resume)
        self.watch = W.QPushButton('Watch learned robot')
        self.watch.setEnabled(False)
        self.watch.clicked.connect(self.watch_policy)
        row.addWidget(self.watch)
        layout.addLayout(row)
        location = W.QLabel(str(self.folder))
        location.setTextInteractionFlags(C.Qt.TextSelectableByMouse)
        location.setWordWrap(True)
        layout.addWidget(location)
        self.process = C.QProcess(self)
        self.process.setProcessChannelMode(C.QProcess.MergedChannels)
        self.process.readyReadStandardOutput.connect(self.read_output)
        self.process.finished.connect(self.training_finished)
        self.process.errorOccurred.connect(self.process_error)

    }
    def start(self, resume=False)
    {
        if self.running
        {
            return
        }
        try
        {
            executable = runtime()
        }
        except Exception as e
        {
            self.fail(str(e))
            return
        }
        self.buffer = ''
        self.running = True
        self.stop_requested = False
        self.progress.setValue(0)
        self.progress.setMaximum(self.config['steps'])
        self.stop.setEnabled(False)
        self.resume.setEnabled(False)
        self.watch.setEnabled(False)
        self.state.setText('Starting training…')
        self.process.setProcessEnvironment(process_environment())
        script = self.folder / 'robot_training.py'
        if not script.exists()
        {
            script = ROOT / 'robot_training.py'
        }
        args = ['-u', str(script), str(self.folder / 'task.json'), '--steps', str(self.config['steps'])]
        if resume
        {
            args.append('--resume')
        }
        self.process.start(str(executable), args)

    }
    def read_output(self)
    {
        self.buffer += bytes(self.process.readAllStandardOutput()).decode('utf-8', errors='replace')
        while '\n' in self.buffer
        {
            line, self.buffer = self.buffer.split('\n', 1)
            try
            {
                event = json.loads(line)
            }
            except (ValueError, TypeError)
            {
                if line
                {
                    self.log.appendPlainText(line)
                }
                continue
            }
            self.handle_event(event)

        }
    }
    def handle_event(self, event)
    {
        kind = event.get('event')
        if kind == 'started'
        {
            self.state.setText('Learning through repeated attempts…')
            self.stop.setEnabled(True)
        }
        elif kind == 'progress'
        {
            self.progress.setValue(min(event['steps'], self.config['steps']))
            text = f"{event['steps']:,} / {event['total']:,} steps · {event['seconds']:.0f} seconds"
            if event.get('mean_reward') is not None
            {
                text += f" · recent reward {event['mean_reward']:.2f}"
            }
            self.metrics.setText(text)
        }
        elif kind == 'evaluating'
        {
            self.state.setText('Policy saved. Checking what it learned…')
            self.stop.setEnabled(False)
        }
        elif kind == 'finished'
        {
            self.state.setText('Stopped and saved.' if event['stopped'] else 'Training saved. Goal not achieved in evaluation.' if event['success_rate'] == 0 else 'Training finished and saved.')
            self.metrics.setText(f"Success in evaluation: {event['success_rate']:.0%} over {event['evaluation_episodes']} attempts · average reward {event['mean_reward']:.2f}")
            self.log.appendPlainText(self.metrics.text())
            self.progress.setValue(min(event['steps'], self.config['steps']))
        }
        elif kind == 'error'
        {
            self.fail(event['message'])

        }
    }
    def training_finished(self, code, status)
    {
        self.read_output()
        self.running = False
        self.stop.setEnabled(False)
        saved = (self.folder / 'policy.zip').exists()
        self.resume.setEnabled(saved)
        self.watch.setEnabled(saved)
        if code != 0
        {
            self.state.setText('Training failed. See details below.')
            self.log.appendPlainText(f'Process exited with code {code}.')

        }
    }
    def process_error(self, error)
    {
        if error == C.QProcess.FailedToStart
        {
            self.running = False
            self.stop.setEnabled(False)
            self.fail(self.process.errorString())

        }
    }
    def fail(self, message)
    {
        self.state.setText('Could not start this training task.')
        self.log.appendPlainText(message)

    }
    def stop_training(self)
    {
        if self.running and self.process.processId()
        {
            os.kill(self.process.processId(), signal.SIGINT)
            self.stop_requested = True
            self.stop.setEnabled(False)
            self.state.setText('Saving the policy…')

        }
    }
    def watch_policy(self)
    {
        if any((p.state() != C.QProcess.NotRunning for p in self.watchers))
        {
            self.log.appendPlainText('The learned robot viewer is already open.')
            return
        }
        try
        {
            process = C.QProcess(self)
            process.setProcessEnvironment(process_environment())
            process.setProcessChannelMode(C.QProcess.MergedChannels)
            self.watchers.append(process)
            process.readyReadStandardOutput.connect(lambda: self.log.appendPlainText(bytes(process.readAllStandardOutput()).decode(errors='replace').strip()))
            process.errorOccurred.connect(lambda: self.log.appendPlainText(process.errorString()))
            script = self.folder / 'robot_training.py'
            if not script.exists()
            {
                script = ROOT / 'robot_training.py'
            }
            process.start(str(runtime(True)), [str(script), str(self.folder / 'task.json'), '--watch'])
        }
        except Exception as e
        {
            self.log.appendPlainText(str(e))

        }
    }
    def closeEvent(self, event)
    {
        if self.running
        {
            self.hide()
            event.ignore()
        }
        else
        {
            event.accept()

        }
    }
}
def job_folder()
{
    stamp = datetime.now(ZoneInfo('America/New_York')).strftime('%Y%m%d-%H%M%S')
    return ROOT / 'Training' / f'{stamp}-{uuid.uuid4().hex[:6]}'

}
class TrainingLibrary(W.QDialog)

{
    def __init__(self, parent=None)
    {
        super().__init__(parent)
        self.setWindowTitle('Saved training')
        self.resize(880, 450)
        self.path = None
        layout = W.QVBoxLayout(self)
        label = W.QLabel('Choose a saved robot and goal to continue training or watch its policy.')
        label.setWordWrap(True)
        layout.addWidget(label)
        self.list = W.QTreeWidget()
        self.list.setHeaderLabels(['Training', 'Goal', 'Learned steps', 'Evaluation success', 'Updated'])
        self.list.setRootIsDecorated(False)
        layout.addWidget(self.list, 1)
        paths = sorted((ROOT / 'Training').glob('*/task.json'), key=lambda p: p.stat().st_mtime, reverse=True)
        for path in paths
        {
            try
            {
                config = json.loads(path.read_text())
                results_file = path.parent / 'results.json'
                results = json.loads(results_file.read_text()) if results_file.exists() else {}
                success = f"{results['success_rate']:.0%}" if 'success_rate' in results else 'Not trained yet'
                updated = datetime.fromtimestamp(max(path.stat().st_mtime, results_file.stat().st_mtime if results_file.exists() else 0), ZoneInfo('America/New_York')).strftime('%b %d, %H:%M')
                item = W.QTreeWidgetItem([str(config.get('name', 'Robot training')), {'pose': 'Joint pose', 'reach': 'Point reaching', 'ground_flight':'Ground takeoff + flight'}.get(config.get('goal'), 'Custom goal'), f"{results.get('total_steps', 0):,}", success, updated])
                item.setData(0, C.Qt.UserRole, str(path))
                self.list.addTopLevelItem(item)
            }
            except (ValueError, TypeError, KeyError, OSError)
            {
                continue
            }
        }
        for column in range(5)
        {
            self.list.resizeColumnToContents(column)
        }
        if self.list.topLevelItemCount()
        {
            self.list.setCurrentItem(self.list.topLevelItem(0))
        }
        else
        {
            layout.addWidget(W.QLabel('No saved training yet. Use Create Training to begin.'))
        }
        buttons = W.QDialogButtonBox(W.QDialogButtonBox.Open | W.QDialogButtonBox.Cancel)
        buttons.button(W.QDialogButtonBox.Open).setText('Open training')
        buttons.accepted.connect(self.accept)
        buttons.rejected.connect(self.reject)
        browse = W.QPushButton('Browse another location…')
        browse.clicked.connect(self.browse)
        buttons.addButton(browse, W.QDialogButtonBox.ActionRole)
        layout.addWidget(buttons)
        self.list.itemDoubleClicked.connect(lambda: self.accept())

    }
    def browse(self)
    {
        path, _ = W.QFileDialog.getOpenFileName(self, 'Open a training task', str(ROOT / 'Training'), 'Training task (task.json)')
        if path
        {
            self.path = Path(path)
            super().accept()

        }
    }
    def accept(self)
    {
        item = self.list.currentItem()
        if item
        {
            self.path = Path(item.data(0, C.Qt.UserRole))
            super().accept()
        }
    }
}
