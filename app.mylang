class SketchCanvas(W.QWidget)
{
    changed = C.Signal(object)
    region_clicked = C.Signal(int)

    def __init__(self)
    {
        super().__init__()
        self.setMinimumSize(640, 430)
        self.points = []
        self.regions = []
        self.selected_regions = set()
        self.start = None
        self.mode = 'Rectangle'
        self.snap = 5.0
        self.scale = 3.0
        self.drawing = False

    }
    def point(self, event)
    {
        x = (event.position().x() - self.width() / 2) / self.scale
        y = (self.height() / 2 - event.position().y()) / self.scale
        return [round(x / self.snap) * self.snap, round(y / self.snap) * self.snap]

    }
    def mousePressEvent(self, e)
    {
        if self.mode == 'Select regions'
        {
            point = Point((e.position().x() - self.width()/2)/self.scale, (self.height()/2 - e.position().y())/self.scale)
            for i, region in enumerate(self.regions)
            {
                if region.contains(point)
                {
                    self.region_clicked.emit(i)
                    return
                }
            }
            return
        }
        p = self.point(e)
        if self.mode == 'Circle'
        {
            self.start = p
            self.points = [[p[0] + 1, p[1]], [p[0], p[1] + 1], [p[0] - 1, p[1]]]
        }
        elif self.mode == 'Freehand'
        {
            self.points = [p]
            self.drawing = True
        }
        elif self.mode == 'Polygon'
        {
            self.points.append(p)
        }
        else
        {
            self.start = p
            self.points = [p, p, p, p]
        }
        self.update()

    }
    def mouseMoveEvent(self, e)
    {
        if self.drawing
        {
            p = self.point(e)
            if not self.points or np.linalg.norm(np.array(p) - self.points[-1]) >= max(self.snap, 2)
            {
                self.points.append(p)
                self.update()
            }
        }
        if self.start is not None and e.buttons() & C.Qt.LeftButton
        {
            x, y = self.start
            a, b = self.point(e)
            if self.mode == 'Circle'
            {
                radius = max(1, float(np.hypot(a - x, b - y)))
                self.points = [[x + radius * np.cos(t), y + radius * np.sin(t)] for t in np.linspace(0, 2 * np.pi, 48, endpoint=False)]
            }
            else
            {
                self.points = [[x, y], [a, y], [a, b], [x, b]]
            }
            self.update()

        }
    }
    def mouseReleaseEvent(self, e)
    {
        self.start = None
        self.drawing = False
        if len(self.points) >= 3
        {
            self.changed.emit(self.points)

        }
    }
    def paintEvent(self, e)
    {
        painter = G.QPainter(self)
        painter.fillRect(self.rect(), G.QColor('#f5efdf'))
        painter.setRenderHint(G.QPainter.Antialiasing)
        cx = self.width() / 2
        cy = self.height() / 2
        step = self.snap * self.scale
        painter.setPen(G.QPen(G.QColor('#d5d8bf'), 1))
        for x in np.arange(cx % step, self.width(), step)
        {
            painter.drawLine(int(x), 0, int(x), self.height())
        }
        for y in np.arange(cy % step, self.height(), step)
        {
            painter.drawLine(0, int(y), self.width(), int(y))
        }
        painter.setPen(G.QPen(G.QColor('#9caa83'), 1))
        painter.drawLine(int(cx), 0, int(cx), self.height())
        painter.drawLine(0, int(cy), self.width(), int(cy))
        for i, region in enumerate(self.regions)
        {
            path = G.QPainterPath()
            path.setFillRule(C.Qt.OddEvenFill)
            for ring in [region.exterior, *region.interiors]
            {
                vertices = list(ring.coords)
                path.moveTo(cx + vertices[0][0]*self.scale, cy - vertices[0][1]*self.scale)
                for x, y in vertices[1:]
                {
                    path.lineTo(cx + x*self.scale, cy - y*self.scale)
                }
                path.closeSubpath()
            }
            painter.setPen(G.QPen(G.QColor('#386247'), 2))
            painter.setBrush(G.QColor('#8caf70') if i in self.selected_regions else G.QColor('#ece2c7'))
            painter.drawPath(path)
        }
        if self.points
        {
            poly = G.QPolygonF([C.QPointF(cx + x * self.scale, cy - y * self.scale) for x, y in self.points])
            painter.setPen(G.QPen(G.QColor('#386247'), 2))
            painter.setBrush(G.QColor(112, 151, 83, 65))
            painter.drawPolygon(poly)
            for i, p in enumerate(poly)
            {
                painter.drawEllipse(p, 3, 3)
                if len(poly) <= 24
                {
                    painter.drawText(p + C.QPointF(6, -6), str(i + 1))

                }
            }
        }
    }
}
class SketchDialog(W.QDialog)

{
    def __init__(self, parent)
    {
        super().__init__(parent)
        self.setWindowTitle('Sketch → solid')
        self.resize(780, 600)
        layout = W.QVBoxLayout(self)
        instructions = W.QLabel('Draw an outline, click Add outline, then draw another inside it. Add that outline and select the enclosed areas to extrude. Green areas become solid; tan areas stay empty.')
        instructions.setWordWrap(True)
        layout.addWidget(instructions)
        row = W.QHBoxLayout()
        self.mode = W.QComboBox()
        self.mode.addItems(['Rectangle', 'Circle', 'Polygon', 'Freehand', 'Select regions'])
        row.addWidget(self.mode)
        row.addWidget(W.QLabel('Grid spacing'))
        self.grid = W.QDoubleSpinBox()
        self.grid.setRange(1, 25)
        self.grid.setValue(5)
        row.addWidget(self.grid)
        clear = W.QPushButton('Clear sketch')
        row.addWidget(clear)
        add_outline = W.QPushButton('Add outline')
        row.addWidget(add_outline)
        row.addStretch()
        layout.addLayout(row)
        self.canvas = SketchCanvas()
        layout.addWidget(self.canvas, 1)
        self.constraints = []
        self.outlines = []
        self.region_list = W.QListWidget()
        self.region_list.setMaximumHeight(110)
        layout.addWidget(W.QLabel('Enclosed regions · checked green areas will be extruded'))
        layout.addWidget(self.region_list)
        self.region_list.itemChanged.connect(self.selection_changed)
        self.canvas.region_clicked.connect(self.toggle_region)
        add_outline.clicked.connect(self.add_outline)
        constraint_button = W.QPushButton('Add dimensions and geometric constraints')
        constraint_button.clicked.connect(self.edit_constraints)
        layout.addWidget(constraint_button)
        self.mode.currentTextChanged.connect(lambda mode: constraint_button.setEnabled(mode not in ['Circle', 'Select regions']))
        form = W.QFormLayout()
        self.width = W.QDoubleSpinBox()
        self.depth = W.QDoubleSpinBox()
        self.height = W.QDoubleSpinBox()
        for spin, value in [(self.width, 100), (self.depth, 60), (self.height, 20)]
        {
            spin.setRange(1, 2000)
            spin.setValue(value)
            spin.setSuffix(' mm')
        }
        self.canvas.changed.connect(self.profile_changed)
        form.addRow('Final width', self.width)
        form.addRow('Final depth', self.depth)
        form.addRow('Extrusion height', self.height)
        layout.addLayout(form)
        buttons = W.QDialogButtonBox(W.QDialogButtonBox.Ok | W.QDialogButtonBox.Cancel)
        buttons.button(W.QDialogButtonBox.Ok).setText('Extrude solid')
        layout.addWidget(buttons)
        buttons.accepted.connect(self.accept)
        buttons.rejected.connect(self.reject)
        self.mode.currentTextChanged.connect(lambda s: setattr(self.canvas, 'mode', s))
        self.grid.valueChanged.connect(lambda v: setattr(self.canvas, 'snap', v))
        clear.clicked.connect(self.clear_sketch)

    }
    def clear_sketch(self)
    {
        self.outlines.clear()
        self.canvas.points.clear()
        self.canvas.regions.clear()
        self.canvas.selected_regions.clear()
        self.region_list.clear()
        self.constraints = []
        self.canvas.update()
    }
    def add_outline(self)
    {
        if len(self.canvas.points) < 3
        {
            W.QMessageBox.information(self, 'Draw an outline', 'Draw at least three corners or drag a rectangle or circle first.')
            return False
        }
        outlines = [*self.outlines, deepcopy(self.canvas.points)]
        try
        {
            cells = sketch_cells(outlines)
        }
        except ValueError as error
        {
            W.QMessageBox.information(self, 'Check outline', str(error))
            return False
        }
        self.outlines = outlines
        self.canvas.points = []
        self.constraints = []
        self.width.setEnabled(True)
        self.depth.setEnabled(True)
        self.canvas.regions = cells
        self.region_list.blockSignals(True)
        self.region_list.clear()
        for i, cell in enumerate(cells)
        {
            item = W.QListWidgetItem(f'Region {i+1} · {cell.area:.1f} mm²')
            item.setFlags(item.flags() | C.Qt.ItemIsUserCheckable)
            item.setCheckState(C.Qt.Checked if len(outlines) == 1 else C.Qt.Unchecked)
            self.region_list.addItem(item)
        }
        self.region_list.blockSignals(False)
        self.selection_changed()
        if len(outlines) > 1
        {
            self.mode.setCurrentText('Select regions')
        }
        self.canvas.update()
        return True
    }
    def toggle_region(self, index)
    {
        item = self.region_list.item(index)
        item.setCheckState(C.Qt.Unchecked if item.checkState() == C.Qt.Checked else C.Qt.Checked)
    }
    def selection_changed(self, *args)
    {
        self.canvas.selected_regions = {i for i in range(self.region_list.count()) if self.region_list.item(i).checkState() == C.Qt.Checked}
        cells = [self.canvas.regions[i] for i in sorted(self.canvas.selected_regions)]
        if cells
        {
            from shapely.ops import unary_union
            bounds = unary_union(cells).bounds
            self.width.setValue(bounds[2] - bounds[0])
            self.depth.setValue(bounds[3] - bounds[1])
        }
        self.canvas.update()
    }
    def profile_changed(self, points)
    {
        self.constraints = []
        self.width.setEnabled(True)
        self.depth.setEnabled(True)
        self.measure_profile(points)

    }
    def edit_constraints(self)
    {
        if len(self.canvas.points) < 3
        {
            return
        }
        dialog = ConstraintEditor(self.canvas.points, self.constraints, self)
        if dialog.exec() == W.QDialog.Accepted
        {
            self.constraints = dialog.constraints
            self.canvas.points = dialog.points
            self.canvas.update()
            self.measure_profile(dialog.points)
            self.width.setEnabled(not self.constraints)
            self.depth.setEnabled(not self.constraints)

        }
    }
    def measure_profile(self, points)
    {
        if self.canvas.points != points
        {
            self.constraints = []
        }
        self.width.setValue(max((p[0] for p in points)) - min((p[0] for p in points)))
        self.depth.setValue(max((p[1] for p in points)) - min((p[1] for p in points)))

    }
    def accept(self)
    {
        if self.outlines
        {
            if self.canvas.points and not self.add_outline()
            {
                return
            }
            if not self.canvas.selected_regions
            {
                W.QMessageBox.information(self, 'Select regions', 'Click the enclosed areas or check their boxes to choose what to extrude.')
                return
            }
        }
        elif len(self.canvas.points) < 3
        {
            W.QMessageBox.information(self, 'Draw a profile', 'Draw a closed profile first.')
            return
        }
        super().accept()

    }
}
