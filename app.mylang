        def make_tab(name)
        {
            scroll = W.QScrollArea()
            scroll.setWidgetResizable(True)
            scroll.setFrameShape(W.QFrame.NoFrame)
            widget = W.QWidget()
            form = W.QFormLayout(widget)
            form.setRowWrapPolicy(W.QFormLayout.WrapAllRows)
            form.setFieldGrowthPolicy(W.QFormLayout.AllNonFixedFieldsGrow)
            scroll.setWidget(widget)
            tabs.addTab(scroll, name)
            return form
        }
        form = make_tab('Shape')
        self.name = W.QLineEdit()
        form.addRow('Name', self.name)
        self.shape = W.QComboBox()
        self.shape.addItems(['Box', 'Cylinder', 'Sphere', 'Ellipsoid', 'Screw M3', 'Screw M4', 'Spring', 'Attachment loop', 'Knot', 'Propeller', 'Sketch', 'Boolean', 'Mesh'])
        form.addRow('Feature', self.shape)
        self.size = self.vector(form, 'Dimensions · mm', [0.001, 2000])
        for dimension in self.size
        {
            dimension.setDecimals(3)
        }
        self.fillet = self.spin(0, 100, 0)
        form.addRow('Edge radius · mm', self.fillet)
        self.rotation = self.vector(form, 'Rotation · degrees', [-360, 360])
        self.edit_geometry = W.QPushButton('Edit sketch constraints / Boolean operands')
        self.edit_geometry.clicked.connect(self.edit_feature)
        form.addRow(self.edit_geometry)
        self.pos = self.vector(form, 'Position relative to parent · mm', [-5000, 5000])
        self.mass = W.QLabel()
        form.addRow('Mass including mounted servos', self.mass)
        color = W.QPushButton('Change color')
        color.clicked.connect(self.color)
        form.addRow(color)
        note = W.QLabel('Click a part to select it. Shift-click to add another. Drag colored axes to move or resize.')
        note.setWordWrap(True)
        form.addRow(note)
        form = make_tab('Joint')
        self.parent = W.QComboBox()
        form.addRow('Parent part', self.parent)
        self.joint = W.QComboBox()
        self.joint.addItems(['Fixed', 'Rigid screw M3', 'Rigid screw M4', 'Hinge', 'Slide', 'Ball', 'Free'])
        form.addRow('Connection', self.joint)
        self.axis = W.QComboBox()
        self.axis.addItems(['X', 'Y', 'Z'])
        form.addRow('Motion axis', self.axis)
        self.pivot = self.vector(form, 'Pivot in child coordinates · mm', [-2000, 2000])
        self.minimum = self.spin(-10000, 10000, -90)
        self.maximum = self.spin(-10000, 10000, 90)
        form.addRow('Minimum · degrees / mm', self.minimum)
        form.addRow('Maximum · degrees / mm', self.maximum)
        self.unlimited = W.QCheckBox('Unlimited rotation / travel')
        form.addRow(self.unlimited)
        self.motor = W.QComboBox()
        self.motor.addItems(['None', 'Torque', 'Position', 'Velocity'])
        form.addRow('Motor mode', self.motor)
        self.gear = self.spin(0.001, 10000, 1)
        form.addRow('Gear ratio', self.gear)
        self.kp = self.spin(0, 100000, 30)
        self.kv = self.spin(0, 100000, 2)
        form.addRow('Position gain kp', self.kp)
        form.addRow('Damping / velocity gain kv', self.kv)
        self.control = self.spin(-100000, 100000, 0)
        form.addRow('Initial target · Nm, N, degrees, mm, or /s', self.control)
        self.damping = self.spin(0, 10000, 0.2)
        self.damping.setDecimals(9)
        self.frictionloss = self.spin(0, 10000, 0)
        self.armature = self.spin(0, 10000, 0.001)
        self.armature.setDecimals(9)
        self.stiffness=self.spin(0,10000,0)
        self.stiffness.setDecimals(8)
        self.springref=self.spin(-10000,10000,0)
        form.addRow('Spring stiffness · Nm/rad or N/m',self.stiffness)
        form.addRow('Spring rest angle / travel · degrees / mm',self.springref)
        form.addRow('Joint damping', self.damping)
        form.addRow('Joint friction loss', self.frictionloss)
        form.addRow('Rotor armature', self.armature)
        closure = W.QPushButton('Add loop closure between selected parts')
        closure.clicked.connect(self.add_closure)
        form.addRow(closure)
        clearclosure = W.QPushButton('Remove this part’s loop closure')
        clearclosure.clicked.connect(self.clear_closure)
        form.addRow(clearclosure)
        joint_note = W.QLabel('Rigid screw M3/M4 adds a steel socket screw at the pivot and locks the connection. Set its axis and pivot to the mounting location. Threads and clamping strength are not simulated.')
        joint_note.setWordWrap(True)
        form.addRow(joint_note)
        form = make_tab('Physics')
        self.physics_state = W.QLabel()
        self.physics_state.setWordWrap(True)
        form.addRow(self.physics_state)
        fall = W.QPushButton('Let assembly fall')
        fall.setToolTip('Release the root of this assembly so gravity and ground contact can move it.')
        fall.clicked.connect(lambda: self.set_assembly_floating(True))
        form.addRow(fall)
        anchor = W.QPushButton('Anchor assembly to world')
        anchor.clicked.connect(lambda: self.set_assembly_floating(False))
        form.addRow(anchor)
        self.physics_environment = W.QLabel()
        self.physics_environment.setWordWrap(True)
        form.addRow(self.physics_environment)
        servo_settings = W.QPushButton('Servo model · weight, speed and torque…')
        servo_settings.clicked.connect(lambda: edit_servo(self))
        form.addRow(servo_settings)
        material_settings = W.QPushButton('Choose build material…')
        material_settings.clicked.connect(lambda: edit_material(self))
        form.addRow(material_settings)
        servo_test_button = W.QPushButton('Test servos and wing-only flight…')
        servo_test_button.clicked.connect(lambda: run_servo_test(self))
        form.addRow(servo_test_button)
        scene_settings = W.QPushButton('Choose environment · Earth / Moon / Mars / Space')
        scene_settings.clicked.connect(lambda: edit_environment(self))
        form.addRow(scene_settings)
        flight_settings = W.QPushButton('Wing forces and upward thrust…')
        flight_settings.clicked.connect(lambda: edit_flight(self))
        form.addRow(flight_settings)
        self.density = self.spin(1, 25000, 1000)
        form.addRow('Density · kg/m³', self.density)
        self.torque = self.spin(0.001, 10000, 2)
        form.addRow('Motor force · Nm / N', self.torque)
        self.override_mass = self.spin(0, 100000, 0)
        self.override_mass.setDecimals(6)
        self.override_mass.setToolTip('Mass of this CAD part only. Servo housing masses are added separately; wiring and battery must be included in the geometry or part mass.')
        form.addRow('Part mass override · kg (0 = density)', self.override_mass)
        self.collision = W.QComboBox()
        self.collision.addItems(['Auto', 'Primitive', 'Convex hull', 'Decomposition', 'None'])
        form.addRow('Collision geometry', self.collision)
        self.collision_tolerance = self.spin(0.05, 50, 2)
        form.addRow('Decomposition tolerance · mm', self.collision_tolerance)
        self.friction = self.vector(form, 'Contact friction · sliding, torsional, rolling', [0, 10])
        self.sensors = W.QCheckBox('Export pose and joint sensors')
        form.addRow(self.sensors)
        physics_note = W.QLabel('Auto uses exact primitive collisions for simple solids and convex decomposition for sketches and Booleans. Smaller tolerance preserves finer cavities, at greater export cost.')
        physics_note.setWordWrap(True)
        form.addRow(physics_note)
        apply = W.QPushButton('Apply changes')
        apply.setObjectName('primary')
        apply.clicked.connect(self.apply)
        side.addWidget(apply)
        splitter.setSizes([100, 900, 320])
        self.list.currentRowChanged.connect(self.select)
        self.list.itemSelectionChanged.connect(self.highlight)
        for target in [self.view, self.list]
        {
            for key, fn in [(G.QKeySequence.StandardKey.Copy, lambda: copy_parts(self)), (G.QKeySequence.StandardKey.Paste, lambda: paste_parts(self))]
            {
                shortcut = G.QShortcut(G.QKeySequence(key), target)
                shortcut.setContext(C.Qt.WidgetShortcut)
                shortcut.activated.connect(fn)
            }
            for key in ['Delete', 'Backspace']
            {
                shortcut = G.QShortcut(G.QKeySequence(key), target)
                shortcut.setContext(C.Qt.WidgetShortcut)
                shortcut.activated.connect(self.remove)
            }
        }
        for key, fn in [('Ctrl+Z', self.undo), ('Ctrl+Shift+Z', self.redo), ('Ctrl+S', self.save), ('Ctrl+D', self.duplicate)]
        {
            shortcut = G.QShortcut(G.QKeySequence(key), self)
            shortcut.activated.connect(fn)
        }
        for key, fn in [('K', self.add_sketch), ('J', self.join_selected), ('F', self.frame_selection), ('1', lambda: self.camera_view('Front')), ('3', lambda: self.camera_view('Right')), ('7', lambda: self.camera_view('Top'))]
        {
            shortcut = G.QShortcut(G.QKeySequence(key), self.view)
            shortcut.setContext(C.Qt.WidgetShortcut)
            shortcut.activated.connect(fn)
        }
        self.joint.currentTextChanged.connect(self.inspector_state)
        self.motor.currentTextChanged.connect(self.inspector_state)
        self.set_tool('Select')
        self.autosave_timer = C.QTimer(self)
        self.autosave_timer.timeout.connect(self.autosave)
        self.autosave_timer.start(30000)
        self.statusBar().showMessage('Ready • two sketch solids')
        self.refresh()
        self.list.clearSelection()
        self.frame_selection()

    }
    def inspector_state(self)
    {
        joint = self.joint.currentText()
        mode = self.motor.currentText()
        scalar = joint in ['Hinge', 'Slide']
        moving = joint in ['Hinge', 'Slide', 'Ball']
        for w in [self.axis, self.minimum, self.maximum, self.unlimited]
        {
            w.setEnabled(scalar)
        }
        for w in self.pivot + [self.damping, self.frictionloss, self.armature,self.stiffness,self.springref]
        {
            w.setEnabled(moving)
        }
        self.motor.setEnabled(moving)
        for w in [self.gear, self.control, self.torque]
        {
            w.setEnabled(moving and mode != 'None')
        }
        self.kp.setEnabled(scalar and mode == 'Position')
        self.kv.setEnabled(scalar and mode in ['Position', 'Velocity'])
        unit = ('°' if joint == 'Hinge' else ' mm') if mode == 'Position' else ('°/s' if joint == 'Hinge' else ' mm/s') if mode == 'Velocity' else ' N' if joint == 'Slide' else ' Nm'
        self.control.setSuffix(unit)

    }
    def spin(self, lo, hi, value)
    {
        s = W.QDoubleSpinBox()
        s.setRange(lo, hi)
        s.setDecimals(2)
        s.setValue(value)
        return s

    }
    def vector(self, form, label, limits, suffix='')
    {
        row = W.QWidget()
        layout = W.QHBoxLayout(row)
        layout.setContentsMargins(0, 0, 0, 0)
        spins = []
        for axis in 'XYZ'
        {
            s = self.spin(*limits, 0)
            s.setPrefix(axis + ' ')
            s.setSuffix(suffix)
            s.setMinimumWidth(0)
            s.setMaximumWidth(86)
            s.setSizePolicy(W.QSizePolicy.Ignored, W.QSizePolicy.Fixed)
            layout.addWidget(s)
            spins.append(s)
        }
        form.addRow(label, row)
        return spins

    }
    def remember(self)
    {
        from copy import deepcopy
        self.history.append(deepcopy(self.parts))
        self.history = self.history[-50:]
        self.redo_history.clear()
        self.dirty = True

    }
    def undo(self)
    {
        if self.history
        {
            from copy import deepcopy
            self.redo_history.append(deepcopy(self.parts))
            self.parts = self.history.pop()
            self.mesh_cache.clear()
            self.refresh()

        }
    }
    def redo(self)
    {
        if self.redo_history
        {
            from copy import deepcopy
            self.history.append(deepcopy(self.parts))
            self.parts = self.redo_history.pop()
            self.mesh_cache.clear()
            self.refresh()

        }
    }
    def error(self, e)
    {
        W.QMessageBox.warning(self, 'Check your design', str(e))

    }
    def refresh(self)
    {
        self.list.blockSignals(True)
        self.list.clear()
        for p in self.parts
        {
            item = W.QListWidgetItem(('↳ ' if p.parent else '') + p.name + '  ·  ' + p.joint)
            item.setToolTip(p.shape + ' · parent: ' + (p.parent or 'world'))
            pix = G.QPixmap(12, 12)
            pix.fill(G.QColor.fromRgbF(*p.color))
            item.setIcon(G.QIcon(pix))
            self.list.addItem(item)
        }
        self.selected = min(max(self.selected, 0), len(self.parts) - 1)
        self.list.setCurrentRow(self.selected)
        self.list.blockSignals(False)
        self.select(self.selected)
        self.render()

    }
    def select(self, row)
    {
        if row < 0
        {
            return
        }
        self.selected = row
        p = self.parts[row]
        self.name.setText(p.name)
        self.shape.setCurrentText(p.shape)
        for widgets, values in [(self.size, p.size), (self.pos, p.position), (self.pivot, p.pivot), (self.rotation, p.rotation), (self.friction, p.friction)]
        {
            for w, v in zip(widgets, values)
            {
                w.setValue(v)
            }
        }
        self.fillet.setValue(p.fillet)
        self.parent.clear()
        self.parent.addItem('World (root)', '')
        for q in self.parts
        {
            if q.name != p.name
            {
                self.parent.addItem(q.name, q.name)
            }
        }
        self.parent.setCurrentIndex(max(0, self.parent.findData(p.parent)))
        self.joint.setCurrentText(p.joint)
        self.axis.setCurrentText(p.axis)
        self.minimum.setValue(p.limits[0])
        self.maximum.setValue(p.limits[1])
        self.density.setValue(p.density)
        self.torque.setValue(p.torque)
        for name in ['gear', 'kp', 'kv', 'control', 'damping', 'frictionloss', 'armature', 'collision_tolerance', 'stiffness', 'springref']
        {
            getattr(self, name).setValue(getattr(p, name))
        }
        self.override_mass.setValue(p.mass)
        self.unlimited.setChecked(p.unlimited)
        self.sensors.setChecked(p.sensors)
        self.motor.setCurrentText(p.motor)
        self.collision.setCurrentText(p.collision)
        self.inspector_state()
        root = self.assembly_root(p)
        scene = environment(self.parts)
        self.physics_environment.setText(f"Environment: {scene.get('preset', 'Custom')} · gravity {scene['gravity']} m/s² · ground {'on' if scene['ground'] else 'off'}")
        self.physics_state.setText(('Floating assembly: forces can move it.' if root.joint == 'Free' else 'Anchored assembly: the base stays fixed.' if root.joint in ['Fixed','Rigid screw M3','Rigid screw M4'] else 'Constrained assembly: motion follows its root joint.') + ' Root: ' + root.name + ('. Collision is disabled for this part.' if p.collision == 'None' else ''))
        self.edit_geometry.setEnabled(p.shape in ['Sketch', 'Boolean'])
        for w in self.size[:2]
        {
            w.setEnabled(p.shape != 'Boolean' and (not p.constraints))
        }
        self.size[2].setEnabled(p.shape != 'Boolean')
        self.mass.setText('Calculating…')
        key = geometry_key(p)
        if key in self.mesh_cache
        {
            self.mass.setText(f'{p.mass or self.mesh_cache[key][2] * 1e-09 * p.density:.4f} kg')
        }
        if self.items and len(self.items) == len(self.parts)
        {
            self.render_gizmo()
        }
        self.measurements.update_dimensions()
        self.view.update()

    }
    def selected_rows(self)
    {
        return sorted({i.row() for i in self.list.selectedIndexes()})

    }
    def highlight(self)
    {
        selected = self.selected_rows()
        names = [self.parts[i].name for i in selected if i < len(self.parts)]
        for i, item in enumerate(self.items[:len(self.parts)])
        {
            item.setColor((0.91, 0.72, 0.36, 1.0) if i in selected else tuple(self.parts[i].color))
            item.opts['drawEdges'] = False
            item.update()
        }
        for overlay in self.selection_overlays
        {
            self.view.removeItem(overlay)
        }
        self.selection_overlays = []
        for i in selected
        {
            if i >= len(self.boxes)
            {
                continue
            }
            lo, hi = self.boxes[i]
            padding = np.maximum((hi - lo) * 0.025, 1.0)
            lo = lo - padding
            hi = hi + padding
            corners = np.array([[x, y, z] for x in [lo[0], hi[0]] for y in [lo[1], hi[1]] for z in [lo[2], hi[2]]])
            edges = []
            for a in range(8)
            {
                for mask in [1, 2, 4]
                {
                    b = a ^ mask
                    if a < b
                    {
                        edges.extend([corners[a], corners[b]])
                    }
                }
            }
            line = gl.GLLinePlotItem(pos=np.array(edges), color=(1.0, 0.86, 0.52, 1), width=2, mode='lines', antialias=True)
            line.setGLOptions('translucent')
            self.view.addItem(line)
            self.selection_overlays.append(line)
        }
        if hasattr(self, 'delete_button')
        {
            self.delete_button.setEnabled(bool(selected))
        }
        if hasattr(self, 'join_button')
        {
            self.join_button.setEnabled(len(selected) == 2)
        }
        if hasattr(self, 'boolean_button')
        {
            self.boolean_button.setEnabled(len(selected) == 2)
        }
        if hasattr(self, 'selection_label')
        {
            self.selection_label.setText('Selected: ' + (' + '.join(names) if names else 'none') + '    ·    ' + ('Ready to join' if len(selected) == 2 else 'Shift-click to select two parts'))
        }
        self.measurements.update_dimensions()
        self.view.update()

    }
    def frame_selection(self)
    {
        if len(self.boxes) != len(self.parts)
        {
            return
        }
        rows = self.selected_rows() or list(range(len(self.parts)))
        if not rows
        {
            return
        }
        lo = np.min([self.boxes[i][0] for i in rows], axis=0)
        hi = np.max([self.boxes[i][1] for i in rows], axis=0)
        center = (lo + hi) / 2
        self.view.opts['center'] = G.QVector3D(*map(float, center))
        self.view.opts['distance'] = max(float(np.linalg.norm(hi - lo)) * 2.2, 100)
        self.view.update()

    }
    def camera_view(self, name)
    {
        azimuth, elevation = {'Front': (-90, 0), 'Right': (0, 0), 'Top': (-90, 90)}[name]
        self.view.setCameraPosition(azimuth=azimuth, elevation=elevation)

    }
    def autosave(self)
    {
        if self.parts and self.dirty and (os.environ.get('MUJOCAD_DISABLE_RECOVERY') != '1')
        {
            try
            {
                save_project(ROOT / 'Recovery.mjcad', self.parts)
            }
            except Exception
            {
                pass

            }
        }
    }
    def closeEvent(self, event)
    {
        running = [p for p in self.training_panels if p.running]
        if running
        {
            answer = W.QMessageBox.question(self, 'Training is running', 'Stop training and close the editor? Use Cancel to keep training.', W.QMessageBox.Ok | W.QMessageBox.Cancel)
            if answer != W.QMessageBox.Ok
            {
                event.ignore()
                return
            }
            for panel in running
            {
                panel.stop_training()
                if not panel.process.waitForFinished(15000)
                {
                    panel.process.kill()
                    panel.process.waitForFinished(2000)
                }
            }
        }
        for panel in self.training_panels
        {
            for viewer in panel.watchers
            {
                if viewer.state() != C.QProcess.NotRunning
                {
                    viewer.terminate()
                    viewer.waitForFinished(2000)
                }
            }
        }
        self.autosave()
        self.pool.waitForDone(1000)
        self.cad_worker.close()
        self.pool.waitForDone(1000)
        event.accept()

    }
    def update_grid(self, *args)
    {
        for item in self.grid_items
        {
            self.view.removeItem(item)
        }
        self.grid_items = []
        spacing = float(self.grid_spacing.currentText().split()[0])
        extent = 1000.0
        grid = gl.GLGridItem(color=(175, 195, 144, 145))
        grid.setSize(extent, extent)
        grid.setSpacing(spacing, spacing)
        self.view.addItem(grid)
        self.grid_items.append(grid)
        lines = []
        for value in np.arange(-extent / 2, extent / 2 + 0.01, spacing)
        {
            if abs(value / (spacing * 4) - round(value / (spacing * 4))) < 1e-06
            {
                lines.extend([[value, -extent / 2, 0.02], [value, extent / 2, 0.02], [-extent / 2, value, 0.02], [extent / 2, value, 0.02]])
            }
        }
        major = gl.GLLinePlotItem(pos=np.array(lines), color=(0.76, 0.8, 0.58, 0.7), mode='lines', width=1.5, antialias=True, glOptions='translucent')
        self.view.addItem(major)
        self.grid_items.append(major)
        for points, color in [([[-500, 0, 0.04], [500, 0, 0.04]], (0.91, 0.62, 0.43, 1)), ([[0, -500, 0.04], [0, 500, 0.04]], (0.62, 0.84, 0.57, 1))]
        {
            axis = gl.GLLinePlotItem(pos=np.array(points), color=color, width=2, antialias=True, glOptions='translucent')
            self.view.addItem(axis)
            self.grid_items.append(axis)
        }
        self.view.update()

    }
    def set_tool(self, name)
    {
        self.view.tool = name
        self.view.setFocus()
        self.view.setCursor(C.Qt.CrossCursor if name == 'Measure' else C.Qt.ArrowCursor)
        if name == 'Measure' and (not self.measurements.points)
        {
            self.measurements.clear()
        }
        for tool, button in self.tool_buttons.items()
        {
            button.setChecked(tool == name)
        }
        if self.items and len(self.items) == len(self.parts)
        {
            self.render_gizmo()
        }
        self.view.update()

    }
    def gizmo_axis(self, part, axis)
    {
        return world_matrix(part, self.parts)[:3, axis] if self.view.tool in ['Scale', 'Extrude'] else np.eye(3)[axis]

    }
    def rotation_ring(self, axis)
    {
        center = np.array(world_position(self.parts[self.selected], self.parts))
        radius = max(20.0, float(np.linalg.norm(self.boxes[self.selected][1] - self.boxes[self.selected][0])) * 0.6)
        angles = np.linspace(0, 2 * np.pi, 97)
        basis = [i for i in range(3) if i != axis]
        points = np.tile(center, (len(angles), 1))
        points[:, basis[0]] += radius * np.cos(angles)
        points[:, basis[1]] += radius * np.sin(angles)
        return points

    }
    def render_gizmo(self)
    {
        for item in getattr(self, 'gizmos', [])
        {
            self.view.removeItem(item)
        }
        self.gizmos = []
        if not self.parts
        {
            return
        }
        p = self.parts[self.selected]
        if self.tabs.currentIndex() == 1 and p.joint in ['Hinge', 'Slide', 'Ball']
        {
            matrix = world_matrix(p, self.parts)
            pivot = matrix[:3, :3] @ np.array(p.pivot) + matrix[:3, 3]
            marker = gl.GLScatterPlotItem(pos=np.array([pivot]), color=(1, 0.88, 0.4, 1), size=13, pxMode=True)
            self.view.addItem(marker)
            self.gizmos.append(marker)
            axis = matrix[:3, 'XYZ'.index(p.axis)]
            line = gl.GLLinePlotItem(pos=np.array([pivot - axis * 25, pivot + axis * 25]), color=(1, 0.88, 0.4, 1), width=3, antialias=True)
            self.view.addItem(line)
            self.gizmos.append(line)
        }
        if self.view.tool == 'Rotate'
        {
            for axis, color in enumerate([(1, 0.4, 0.4, 1), (0.5, 0.9, 0.5, 1), (0.5, 0.7, 1, 1)])
            {
                line = gl.GLLinePlotItem(pos=self.rotation_ring(axis), color=color, width=3, antialias=True)
                self.view.addItem(line)
                self.gizmos.append(line)
            }
            self.view.update()
            return
        }
        if self.view.tool not in ['Move', 'Scale', 'Extrude']
        {
            self.view.update()
            return
        }
        center = np.array(world_position(self.parts[self.selected], self.parts))
        for a, color in enumerate([(1, 0.3, 0.4, 1), (0.3, 0.9, 0.5, 1), (0.3, 0.6, 1, 1)])
        {
            end = center + self.gizmo_axis(self.parts[self.selected], a) * self.gizmo_length
            line = gl.GLLinePlotItem(pos=np.array([center, end]), color=color, width=4, antialias=True)
            self.view.addItem(line)
            self.gizmos.append(line)

        }
    }
    def run_job(self, fn, callback, message, on_error=None)
    {
        self.statusBar().showMessage(message)
        job = Job(fn)
        self.jobs.append(job)
        job.callback = callback
        job.failure_callback = on_error
        job.signals.result.connect(self.job_result, C.Qt.QueuedConnection)
        job.signals.error.connect(self.job_error, C.Qt.QueuedConnection)
        self.pool.start(job)

    }
    @C.Slot(object)
    def job_result(self, payload)
    {
        job, result = payload
        try
        {
            job.callback(result)
        }
        except Exception as e
        {
            self.error(e)
        }
        finally
        {
            if job in self.jobs
            {
                self.jobs.remove(job)

            }
        }
    }
    @C.Slot(object)
    def job_error(self, payload)
    {
        job, error = payload
        if job in self.jobs
        {
            self.jobs.remove(job)
        }
        self.preview_pending = False
        if job.failure_callback
        {
            job.failure_callback(error)
        }
        else
        {
            self.error(error)

        }
    }
    def render(self)
    {
        self.measurements.clear()
        self.render_revision += 1
        revision = self.render_revision
        snapshot = deepcopy(self.parts)
        missing = {geometry_key(p): p for p in snapshot if geometry_key(p) not in self.mesh_cache}
        if missing
        {
            self.preview_pending = True

            def build()
            {
                return self.cad_worker.request('preview_batch', missing)

            }
            def ready(meshes)
            {
                self.mesh_cache.update(meshes)
                pinned = {geometry_key(p) for p in self.parts}
                for key in list(self.mesh_cache)
                {
                    memory = sum((v.nbytes + f.nbytes for v, f, _ in self.mesh_cache.values()))
                    if len(self.mesh_cache) <= 128 and memory <= 512 * 1024 ** 2
                    {
                        break
                    }
                    if key not in pinned
                    {
                        self.mesh_cache.pop(key)
                    }
                }
                if revision == self.render_revision
                {
                    self.draw_meshes()
                }
            }
            self.run_job(build, ready, 'Building CAD preview in background…')
        }
        else
        {
            self.draw_meshes()

        }
    }
    def draw_meshes(self)
    {
        self.preview_pending = False
        for item in self.items
        {
            self.view.removeItem(item)
        }
        self.items = []
        self.boxes = []
        self.local_vertices = []
        self.faces = []
        transforms = world_matrices(self.parts)
        for p in self.parts
        {
            verts, faces, volume = self.mesh_cache[geometry_key(p)]
            self.local_vertices.append(verts)
            self.faces.append(faces)
            matrix = transforms[p.name]
            worldverts = verts @ matrix[:3, :3].T + matrix[:3, 3]
            self.boxes.append((worldverts.min(axis=0), worldverts.max(axis=0)))
            item = gl.GLMeshItem(vertexes=verts, faces=faces, color=tuple(p.color), smooth=False, drawEdges=False, shader=CAD_SURFACE)
            item.setTransform(G.QMatrix4x4(*matrix.ravel().tolist()))
            self.view.addItem(item)
            self.items.append(item)
        }
        from physics_features import tendons
        for cable in tendons(self.parts)
        {
            points=np.asarray([(transforms[point['body']]@np.r_[point['position'],1])[:3] for point in cable['points']])
            line=gl.GLLinePlotItem(pos=points,color=(.9,.7,.3,1),width=3,antialias=True)
            self.view.addItem(line);self.items.append(line)
            anchors=gl.GLScatterPlotItem(pos=points,color=(1,.85,.5,1),size=7)
            self.view.addItem(anchors);self.items.append(anchors)
        }
        if self.parts
        {
            p = self.parts[self.selected]
            self.mass.setText(f"{((p.mass or self.mesh_cache[geometry_key(p)][2] * 1e-09 * p.density) + housing_mass_on(p.name, self.parts)) * 1000:.2f} g")
        }
        self.render_gizmo()
        self.highlight()
        if not hasattr(self, 'framed_once') or getattr(self, 'needs_frame', False)
        {
            self.frame_selection()
            self.framed_once = True
            self.needs_frame = False
        }
        self.statusBar().showMessage('Ready • CAD and preview caches active')

    }
    def update_drag(self, drag)
    {
        if self.measurements.points
        {
            self.measurements.clear()
        }
        if len(self.items) != len(self.parts)
        {
            return
        }
        transforms = world_matrices(self.parts)
        for i, p in enumerate(self.parts)
        {
            verts = self.local_vertices[i]
            matrix = transforms[p.name].copy()
            if i == self.selected and self.view.tool in ['Scale', 'Extrude']
            {
                ratio = np.array(p.size) / np.array(drag['size'])
                matrix[:3, :3] = matrix[:3, :3] @ np.diag(ratio)
            }
            self.items[i].setTransform(G.QMatrix4x4(*matrix.ravel().tolist()))
            worldverts = verts @ matrix[:3, :3].T + matrix[:3, 3]
            self.boxes[i] = (worldverts.min(axis=0), worldverts.max(axis=0))
        }
        self.render_gizmo()
        self.highlight()
        self.view.update()

    }
    def join_selected(self)
    {
        rows = self.selected_rows()
        if len(rows) != 2
        {
            self.error('Select exactly two parts with Shift-click in the canvas or object list.')
            return
        }
        parent, child = [self.parts[i] for i in rows]
        dialog = W.QDialog(self)
        dialog.setWindowTitle('Join two parts')
        form = W.QFormLayout(dialog)
        orientation = W.QComboBox()
        orientation.addItems([f'{parent.name} → {child.name}', f'{child.name} → {parent.name}'])
        form.addRow('Parent → child', orientation)
        kind = W.QComboBox()
        kind.addItems(['Fixed', 'Rigid screw M3', 'Rigid screw M4', 'Hinge', 'Slide', 'Ball'])
        form.addRow('Connection', kind)
        axis = W.QComboBox()
        axis.addItems(['X', 'Y', 'Z'])
        axis.setCurrentText('Y')
        form.addRow('Motion axis', axis)
        message = W.QLabel('Parts keep their current positions. Fixed joins form one rigid assembly; hinges and sliders allow motion. Joint pivots can be adjusted in the inspector; the Joint tab shows their anchor and axis in the canvas.')
        message.setWordWrap(True)
        form.addRow(message)
        buttons = W.QDialogButtonBox(W.QDialogButtonBox.Ok | W.QDialogButtonBox.Cancel)
        buttons.button(W.QDialogButtonBox.Ok).setText('Join parts')
        form.addRow(buttons)
        buttons.accepted.connect(dialog.accept)
        buttons.rejected.connect(dialog.reject)
        if dialog.exec() != W.QDialog.Accepted
        {
            return
        }
        if orientation.currentIndex()
        {
            parent, child = (child, parent)
        }
        self.connect_parts(parent.name, child.name, kind.currentText(), axis.currentText())

    }
    def connect_parts(self, parent_name, child_name, kind='Fixed', axis='Y')
    {
        from copy import deepcopy
        before = deepcopy(self.parts)
        lookup = {p.name: p for p in self.parts}
        parent = lookup[parent_name]
        child = lookup[child_name]
        child_world = world_matrix(child, self.parts)
        child.parent = parent.name
        child.joint = kind
        from hardware import ensure_screw
        child.axis = axis
        ensure_screw(child,self.parts)
        try
        {
            set_world_matrix(child, child_world, self.parts)
        }
        except Exception as e
        {
            self.parts = before
            self.error(e)
            return False
        }
        if kind == 'Slide'
        {
            child.limits = [-50, 50]
        }
        try
        {
            validate(self.parts)
        }
        except Exception as e
        {
            self.parts = before
            self.error(e)
            return False
        }
        self.history.append(before)
        self.redo_history.clear()
        self.dirty = True
        self.selected = self.parts.index(child)
        self.refresh()
        self.statusBar().showMessage(f'Joined {child.name} to {parent.name} • {kind}')
        return True

    }
    def apply(self)
    {
        if not self.parts
        {
            return
        }
        from copy import deepcopy
        old = deepcopy(self.parts)
        self.remember()
        p = self.parts[self.selected]
        previous = p.name
        try
        {
            p.name = self.name.text().strip()
            p.shape = self.shape.currentText()
            p.size = [s.value() for s in self.size]
            p.position = [s.value() for s in self.pos]
            p.pivot = [s.value() for s in self.pivot]
            p.parent = self.parent.currentData()
            p.joint = self.joint.currentText()
            p.axis = self.axis.currentText()
            p.limits = [self.minimum.value(), self.maximum.value()]
            p.density = self.density.value()
            p.torque = self.torque.value()
            p.fillet = self.fillet.value()
            p.rotation = [w.value() for w in self.rotation]
            p.friction = [w.value() for w in self.friction]
            for name in ['gear', 'kp', 'kv', 'control', 'damping', 'frictionloss', 'armature', 'collision_tolerance', 'stiffness', 'springref']
            {
                setattr(p, name, getattr(self, name).value())
            }
            p.mass = self.override_mass.value()
            p.unlimited = self.unlimited.isChecked()
            p.sensors = self.sensors.isChecked()
            p.motor = self.motor.currentText()
            p.collision = self.collision.currentText()
            for q in self.parts
            {
                for cable in q.tendons
                {
                    for point in cable['points']
                    {
                        if point['body'] == previous
                        {
                            point['body'] = p.name
                        }
                    }
                }
                if q.parent == previous
                {
                    q.parent = p.name
                }
                if q.closure.get('body') == previous
                {
                    q.closure['body'] = p.name
                }
            }
            from hardware import ensure_screw
            ensure_screw(p,self.parts)
            validate(self.parts)
            candidate = deepcopy(self.parts)
            index = self.selected
            self.parts = old

            def done(mesh)
            {
                if self.parts != old
                {
                    self.error('Design changed; apply again.')
                    return
                }
                self.parts = candidate
                self.mesh_cache[geometry_key(candidate[index])] = mesh
                self.refresh()
            }
            changed = deepcopy(p)
            self.run_job(lambda: self.cad_worker.request('preview', changed), done, 'Applying CAD parameters…')
        }
        except Exception as e
        {
            self.parts = old
            self.error(e)

        }
    }
    def unique(self, prefix)
    {
        n = 1
        while f'{prefix}_{n}' in [p.name for p in self.parts]
        {
            n += 1
        }
        return f'{prefix}_{n}'

    }
    def add_part(self)
    {
        self.remember()
        self.parts.append(Part(self.unique('part'), position=[100, 0, 25]))
        self.selected = len(self.parts) - 1
        self.refresh()

    }
    def add_sketch(self)
    {
        if hasattr(self, 'active_sketch') and self.active_sketch is not None
        {
            self.stack.setCurrentWidget(self.active_sketch)
            return
        }
        d = SketchDialog(self)
        d.setWindowFlags(C.Qt.Widget)
        self.active_sketch = d
        self.stack.addWidget(d)
        self.stack.setCurrentWidget(d)
        d.show()

        def finish()
        {
            self.stack.setCurrentWidget(self.view)
            self.stack.removeWidget(d)
            self.active_sketch = None
            d.deleteLater()

        }
        def accept()
        {
            if d.outlines
            {
                cells = [d.canvas.regions[i] for i in sorted(d.canvas.selected_regions)]
                p = region_part(self.unique('sketch'), cells, d.width.value(), d.depth.value(), d.height.value(), [100 + len(self.parts)*30, 0, d.height.value()/2])
            }
            else
            {
            p = Part(self.unique('sketch'), shape='Cylinder' if d.mode.currentText() == 'Circle' else 'Sketch', sketch=list(d.canvas.points), constraints=deepcopy(d.constraints), size=[d.width.value(), d.depth.value(), d.height.value()], position=[100 + len(self.parts) * 30, 0, d.height.value() / 2])
            }

            def done(mesh)
            {
                self.remember()
                self.parts.append(p)
                self.selected = len(self.parts) - 1
                self.mesh_cache[geometry_key(p)] = mesh
                finish()
                self.refresh()
            }
            self.run_job(lambda: self.cad_worker.request('preview', p), done, 'Extruding sketch…')
        }
        d.accepted.connect(accept)
        d.rejected.connect(finish)

    }
    def duplicate(self)
    {
        if not self.parts
        {
            return
        }
        from copy import deepcopy
        p = deepcopy(self.parts[self.selected])
        p.name = self.unique(p.name)
        p.tendons = []
        p.scenario = {}
        p.position[0] += 60
        self.remember()
        self.parts.append(p)
        self.selected = len(self.parts) - 1
        self.refresh()

    }
    def object_context_menu(self, pos)
    {
        item = self.list.itemAt(pos)
        if item is None
        {
            return
        }
        if not item.isSelected()
        {
            self.list.setCurrentItem(item)
        }
        menu = W.QMenu(self)
        menu.addAction('Delete selected objects', self.remove)
        menu.addAction('Duplicate object', self.duplicate)
        menu.exec(self.list.mapToGlobal(pos))

    }
    def remove(self)
    {
        rows = self.selected_rows()
        if not rows
        {
            return
        }
        names = {self.parts[i].name for i in rows}
        if any((q.name not in names and (q.parent in names or q.closure.get('body') in names) for q in self.parts))
        {
            self.error('Select the attached child parts too, or remove their attachments and loop closures before deleting.')
            return
        }
        self.remember()
        self.parts = [p for p in self.parts if p.name not in names]
        for part in self.parts
        {
            part.tendons = [cable for cable in part.tendons if not any(point['body'] in names for point in cable['points'])]
        }
        self.refresh()
        self.statusBar().showMessage(f'Deleted {len(names)} object(s) • Undo restores them')

    }
    def color(self)
    {
        if not self.parts
        {
            return
        }
        p = self.parts[self.selected]
        c = W.QColorDialog.getColor(G.QColor.fromRgbF(*p.color), self)
        if c.isValid()
        {
            self.remember()
            p.color = [c.redF(), c.greenF(), c.blueF(), 1]
            self.render()

        }
    }
    def new_design(self)
    {
        if self.parts and W.QMessageBox.question(self, 'New design', 'Start a blank design? Save your existing design first if you want to keep it.', W.QMessageBox.Ok | W.QMessageBox.Cancel) != W.QMessageBox.Ok
        {
            return
        }
        self.remember()
        self.parts = []
        self.selected = -1
        self.path = None
        self.refresh()

    }
    def save(self)
    {
        path, _ = W.QFileDialog.getSaveFileName(self, 'Save design', str(self.path or ROOT / 'MyRobot.mjcad'), 'MuJoCoCAD (*.mjcad)')
        if path
        {
            try
            {
                save_project(path, self.parts)
                self.path = Path(path)
                self.dirty = False
                self.statusBar().showMessage(f'Saved {path}')
            }
            except Exception as e
            {
                self.error(e)

            }
        }
    }
    def open(self)
    {
        path, _ = W.QFileDialog.getOpenFileName(self, 'Open design', str(ROOT), 'MuJoCoCAD (*.mjcad)')
        if path
        {
            try
            {
                self.parts = load_project(path)
                self.path = Path(path)
                self.selected = 0
                self.history.clear()
                self.redo_history.clear()
                self.needs_frame = True
                self.refresh()
            }
            except Exception as e
            {
                self.error(e)

            }
        }
    }
    def open_example(self, name)
    {
        if self.dirty and W.QMessageBox.question(self, 'Open example', 'Save your current design first if you want to keep it. Open the example?', W.QMessageBox.Ok | W.QMessageBox.Cancel) != W.QMessageBox.Ok
        {
            return
        }
        try
        {
            parts = load_project(ROOT / 'Examples' / f'{name}.mjcad')
            self.remember()
            self.parts = parts
            self.path = None
            self.selected = 0
            self.needs_frame = True
            self.refresh()
        }
        except Exception as e
        {
            self.error(e)

        }
    }
    def boolean_selected(self)
    {
        rows = self.selected_rows()
        if len(rows) != 2
        {
            self.error('Select exactly two parts.')
            return
        }
        a, b = [self.parts[i] for i in rows]
        dialog = W.QDialog(self)
        dialog.setWindowTitle('Parametric Boolean')
        form = W.QFormLayout(dialog)
        order = W.QComboBox()
        order.addItems([f'{a.name} ← {b.name}', f'{b.name} ← {a.name}'])
        form.addRow('Target ← tool', order)
        operation = W.QComboBox()
        operation.addItems(['Union', 'Cut', 'Intersect'])
        form.addRow('Operation', operation)
        buttons = W.QDialogButtonBox(W.QDialogButtonBox.Ok | W.QDialogButtonBox.Cancel)
        form.addRow(buttons)
        buttons.accepted.connect(dialog.accept)
        buttons.rejected.connect(dialog.reject)
        if dialog.exec() != W.QDialog.Accepted
        {
            return
        }
        if order.currentIndex()
        {
            a, b = (b, a)
        }
        if b.joint not in ['Fixed','Rigid screw M3','Rigid screw M4'] or b.closure or any((p.parent == b.name or p.closure.get('body') == b.name for p in self.parts))
        {
            self.error('The tool must be a fixed part with no children or loop connections.')
            return
        }
        snapshot = deepcopy(self.parts)
        target = deepcopy(a)
        tool = deepcopy(b)
        op = operation.currentText()

        def done(result)
        {
            if self.parts != snapshot
            {
                self.error('Design changed during Boolean calculation. Run the operation again.')
                return
            }
            self.remember()
            self.parts = [result if p.name == target.name else p for p in self.parts if p.name != tool.name]
            self.selected = next((i for i, p in enumerate(self.parts) if p.name == result.name))
            self.refresh()
        }
        self.run_job(lambda: self.cad_worker.request('boolean', target, tool, snapshot, op), done, 'Calculating Boolean…')

    }
    def edit_feature(self)
    {
        if not self.parts
        {
            return
        }
        p = self.parts[self.selected]
        candidate = deepcopy(p)
        if p.shape == 'Sketch'
        {
            dialog = ConstraintEditor(p.sketch, p.constraints, self)
            if dialog.exec() != W.QDialog.Accepted
            {
                return
            }
            candidate.sketch = dialog.points
            candidate.constraints = dialog.constraints
            candidate.size[:2] = np.ptp(np.asarray(dialog.points), axis=0).tolist()
        }
        elif p.shape == 'Boolean'
        {
            dialog = BooleanOperands(candidate, self)
            if dialog.exec() != W.QDialog.Accepted
            {
                return
            }
            candidate = dialog.part
        }
        else
        {
            return
        }
        original = deepcopy(self.parts)
        index = self.selected

        def done(result)
        {
            rebuilt, mesh = result
            if self.parts != original
            {
                self.error('Design changed; reopen the feature editor.')
                return
            }
            self.remember()
            self.parts[index] = rebuilt
            self.mesh_cache[geometry_key(rebuilt)] = mesh
            self.refresh()
        }
        self.run_job(lambda: self.cad_worker.request('rebuild', candidate), done, 'Solving parametric feature…')

    }
    def add_closure(self)
    {
        rows = self.selected_rows()
        if len(rows) != 2
        {
            self.error('Select two parts for a loop closure.')
            return
        }
        a, b = [self.parts[i] for i in rows]
        dialog = W.QDialog(self)
        dialog.setWindowTitle('Loop constraint')
        form = W.QFormLayout(dialog)
        kind = W.QComboBox()
        kind.addItems(['Connect', 'Weld'])
        form.addRow('Constraint', kind)
        anchor = self.vector(form, f'Anchor in {a.name} coordinates · mm', [-5000, 5000])
        buttons = W.QDialogButtonBox(W.QDialogButtonBox.Ok | W.QDialogButtonBox.Cancel)
        form.addRow(buttons)
        buttons.accepted.connect(dialog.accept)
        buttons.rejected.connect(dialog.reject)
        if dialog.exec() == W.QDialog.Accepted
        {
            self.remember()
            a.closure = {'body': b.name, 'type': kind.currentText(), 'anchor': [w.value() for w in anchor]}
            self.refresh()

        }
    }
    def clear_closure(self)
    {
        if self.parts
        {
            self.remember()
            self.parts[self.selected].closure = {}
            self.refresh()

        }
    }
    def export(self)
    {
        path = W.QFileDialog.getExistingDirectory(self, 'Choose export folder', str(ROOT))
        if path
        {
            snapshot = deepcopy(self.parts)

            def done(result)
            {
                target, m = result
                self.statusBar().showMessage(f'Export verified: {m.nbody - 1} bodies, {m.nu} motors → {target}')
                W.QMessageBox.information(self, 'Export ready', f'Validated MuJoCo model: {target}\nSTEP solids: cad/\nSTL meshes: meshes/')
            }
            self.run_job(lambda: self.cad_worker.request('export', path, snapshot), done, 'Exporting CAD and computing collision decomposition…')

        }
    }
    def check_lift_capacity(self)
    {
        scenario=next((p.scenario for p in self.parts if p.scenario.get('confined')),None)
        if not scenario
        {
            self.error('Open a compact ornithopter with independent wing incidence controls before checking lift capacity.')
            return
        }
        try
        {
            validate(self.parts)
            from lift_ui import LiftScreenPanel
            from datetime import datetime
            import uuid
            folder=ROOT/'LiftChecks'/(datetime.now().strftime('%Y%m%d-%H%M%S')+'-'+uuid.uuid4().hex[:6])
            folder.mkdir(parents=True)
            snapshot=deepcopy(self.parts)
            panel=LiftScreenPanel(folder,self)
            if not hasattr(self,'lift_panels')
            {
                self.lift_panels=[]
            }
            self.lift_panels.append(panel)
            panel.show()
            config={'version':1,'goal':'ground_flight','model':'robot.xml','motors':[name+'_motor' for name in [scenario['drive'],*scenario['incidence_motors'],scenario['tail']]],'episode_seconds':30,'airborne_seconds':20,'takeoff_height_mm':100,'randomize_start':True}
            def ready(result)
            {
                (folder/'bench-task.json').write_text(json.dumps(config,indent=2))
                panel.start()
            }
            self.run_job(lambda:self.cad_worker.request('export',folder,snapshot),ready,'Preparing lift capacity measurement…',on_error=panel.fail)
        }
        except Exception as error
        {
            self.error(error)
        }
    }

    def create_training(self)
    {
        if not any((p.joint in ['Hinge', 'Slide', 'Ball'] and p.motor != 'None' or p.thruster or any(t['mode'] != 'Passive spring' for t in p.tendons) for p in self.parts))
        {
            dialog = W.QMessageBox(self)
            dialog.setWindowTitle('Add a motor first')
            dialog.setText('Training needs a moving joint with a motor. Add a Hinge or Slide joint in the Joint tab, or try the motorized arm example.')
            example = dialog.addButton('Load motorized arm example', W.QMessageBox.AcceptRole)
            dialog.addButton(W.QMessageBox.Cancel)
            dialog.exec()
            if dialog.clickedButton() == example
            {
                self.open_example('MotorizedArm')
                if any((p.joint in ['Hinge', 'Slide', 'Ball'] and p.motor != 'None' for p in self.parts))
                {
                    C.QTimer.singleShot(0, self.create_training)
                }
            }
            return
        }
        try
        {
            validate(self.parts)
        }
        except Exception as e
        {
            self.error(e)
            return
        }
        wizard = TrainingWizard(self.parts, self)
        if wizard.exec() != W.QDialog.Accepted
        {
            return
        }
        config = wizard.configuration()
        folder = job_folder()
        snapshot = deepcopy(self.parts)
        panel = TrainingPanel(folder, config, self)
        self.training_panels.append(panel)
        panel.show()

        def ready(result)
        {
            (folder / 'task.json').write_text(json.dumps(config, indent=2))
            shutil.copyfile(ROOT / 'robot_training.py', folder / 'robot_training.py')
            shutil.copyfile(ROOT / 'ground_flight_training.py', folder / 'ground_flight_training.py')
            shutil.copyfile(ROOT / 'requirements-training.txt', folder / 'requirements.txt')
            (folder / 'TRAINING.txt').write_text('This folder is an immutable robot and goal snapshot. Train with the CAD Training panel. policy.zip stores the learned policy; results.json stores evaluation results. Changing the live CAD design does not change this run.\n')
            panel.start()
            self.statusBar().showMessage('Training started in background • Training menu opens progress')
        }
        self.run_job(lambda: self.cad_worker.request('export', folder, snapshot), ready, 'Preparing the training robot…', on_error=panel.fail)

    }
    def show_training(self)
    {
        if self.training_panels
        {
            self.training_panels[-1].show()
            self.training_panels[-1].raise_()
        }
        else
        {
            self.open_training()

        }
    }
    def open_training(self)
    {
        library = TrainingLibrary(self)
        if library.exec() != W.QDialog.Accepted or not library.path
        {
            return
        }
        path = library.path
        try
        {
            path = Path(path)
            for panel in self.training_panels
            {
                if panel.folder == path.parent
                {
                    panel.show()
                    panel.raise_()
                    return
                }
            }
            config = json.loads(path.read_text())
            panel = TrainingPanel(path.parent, config, self)
            self.training_panels.append(panel)
            saved = (path.parent / 'policy.zip').exists()
            panel.resume.setEnabled(saved)
            panel.watch.setEnabled(saved)
            panel.state.setText('Saved training task. Continue training or watch the policy.' if saved else 'Prepared task. Click Start training.')
            if not saved
            {
                panel.resume.setText('Start training')
                panel.resume.setEnabled(True)
                panel.resume.clicked.disconnect()
                panel.resume.clicked.connect(lambda: panel.start(False))
            }
            result = path.parent / 'results.json'
            if result.exists()
            {
                panel.handle_event({'event': 'finished', **json.loads(result.read_text())})
            }
            panel.show()
        }
        except Exception as e
        {
            self.error(e)

        }
    }
    def assembly_root(self, part)
    {
        lookup = {p.name: p for p in self.parts}
        seen = set()
        while part.parent and part.name not in seen
        {
            seen.add(part.name)
            part = lookup[part.parent]
        }
        return part

    }
    def set_assembly_floating(self, floating)
    {
        if not self.parts
        {
            return
        }
        root = self.assembly_root(self.parts[self.selected])
        if root.joint not in ['Fixed', 'Free']
        {
            self.error('The root has a ' + root.joint + ' constraint. Change its Connection in the Joint tab to replace that constraint.')
            return
        }
        target = 'Free' if floating else 'Fixed'
        if root.joint == target
        {
            return
        }
        self.remember()
        root.joint = target
        self.refresh()
        self.statusBar().showMessage(root.name + (' released • click Simulate to run scene physics' if floating else ' anchored to world'))

    }
    def simulate(self)
    {
        if not self.parts
        {
            return
        }
        if all((p.joint in ['Fixed','Rigid screw M3','Rigid screw M4'] for p in self.parts))
        {
            dialog = W.QMessageBox(self)
            dialog.setWindowTitle('These parts are anchored')
            dialog.setText('Every part is Fixed, so the assembly is anchored. Release a root to let the chosen environment move it.')
            dialog.setInformativeText('Releasing roots keeps the rig connected and allows falling or space drift. The CAD canvas is an editing preview.')
            release = dialog.addButton('Release roots & simulate', W.QMessageBox.AcceptRole)
            anchored = dialog.addButton('Simulate anchored', W.QMessageBox.ActionRole)
            dialog.addButton(W.QMessageBox.Cancel)
            dialog.exec()
            if dialog.clickedButton() == release
            {
                self.remember()
                for p in self.parts
                {
                    if not p.parent
                    {
                        p.joint = 'Free'
                    }
                }
                self.refresh()
            }
            elif dialog.clickedButton() != anchored
            {
                return
            }
        }
        snapshot = deepcopy(self.parts)

        def done(result)
        {
            target, m = result
            env = os.environ.copy()
            env['PATH'] = '/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin:' + env.get('PATH', '')
            subprocess.Popen([str(__import__('runtime_paths').simulator_runtime()), str(ROOT / 'simulate.py'), str(target)], env=env)
            self.statusBar().showMessage('MuJoCo viewer launched • motor controls in right panel')
        }
        self.run_job(lambda: self.cad_worker.request('export', ROOT / 'simulation', snapshot), done, 'Preparing robot simulation…')
    }
}
if __name__ == '__main__'
{
    app = W.QApplication(sys.argv)
    app.setApplicationName('MuJoCoCAD')
    app.setOrganizationName('MuJoCoCAD')
    app.setStyle('Fusion')
    app.setStyleSheet(STYLE)
    window = Window()
    if len(sys.argv) > 1 and sys.argv[1].endswith('.mjcad')
    {
        window.parts = load_project(sys.argv[1])
        window.path = Path(sys.argv[1])
        window.selected = 0
        window.history.clear()
        window.redo_history.clear()
        window.dirty = False
        window.needs_frame = True
        window.refresh()
    }
    window.cad_activity = CADActivity(window)
    window.show()
    sys.exit(app.exec())
}
