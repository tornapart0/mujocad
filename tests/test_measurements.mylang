// Canonical Tay’s Sensible Lang source. Python is generated at build time.
"""Exercise point picking, dimensions, measurement math and grid controls."""
import time, traceback
import numpy as np
from PySide6 import QtWidgets as W, QtCore as C
from PySide6.QtTest import QTest
from app import Window, STYLE, ROOT
from model import Part
app = W.QApplication([])
app.setStyle('Fusion')
app.setStyleSheet(STYLE)
w = Window()
w.show()
errors = []
w.error = lambda e: errors.append(str(e))

def wait()
{
    deadline = time.monotonic() + 20
    while w.jobs and time.monotonic() < deadline
    {
        QTest.qWait(20)
    }
    assert not w.jobs and (not errors), errors

}
def click(xyz)
{
    xy = w.view.screen(xyz)
    QTest.mouseClick(w.view, C.Qt.LeftButton, C.Qt.NoModifier, C.QPoint(*np.rint(xy).astype(int)))
    QTest.qWait(20)

}
def main()
{
    try
    {
        wait()
        w.parts = [Part('A', position=[0, 0, 25]), Part('B', position=[100, 0, 25], rotation=[0, 0, 45])]
        w.selected = 0
        w.refresh()
        wait()
        w.camera_view('Top')
        w.list.selectAll()
        w.frame_selection()
        w.list.setCurrentRow(0)
        QTest.qWait(100)
        panel = w.measurements
        assert '50.00 × 50.00 × 50.00 mm' in panel.dimensions.text()
        assert '125.00 cm³' in panel.dimensions.text()
        assert w.grid_items[0].color().red() > 100
        w.grid_spacing.setCurrentText('50 mm')
        assert w.grid_items[0].spacing()[0] == 50
        assert len(w.grid_items) == 4
        w.set_tool('Measure')
        panel.snap.setChecked(False)
        click([-15, -10, 50])
        click([15, -10, 50])
        assert len(panel.points) == 2
        assert np.isclose(np.linalg.norm(panel.points[1] - panel.points[0]), 30, atol=0.5), panel.points
        assert 'Distance:' in panel.result.text() and 'ΔX' in panel.result.text()
        panel.mode.setCurrentIndex(1)
        click([-10, 0, 50])
        click([0, 0, 50])
        click([0, 10, 50])
        assert '90.' in panel.result.text(), panel.result.text()
        panel.mode.setCurrentIndex(0)
        panel.snap.setChecked(True)
        point = w.view.measurement_point(C.QPointF(*w.view.screen([-24.8, -24.8, 50])))
        assert np.allclose(point, [-25, -25, 50]), point
        panel.clear()
        assert not panel.points and (not panel.overlays)
        w.list.selectAll()
        panel.measure_centers()
        assert np.isclose(np.linalg.norm(panel.points[1] - panel.points[0]), 100)
        assert 'Part centers' in panel.result.text()
        assert '2 selected parts' in panel.dimensions.text()
        assert '160.36' in panel.dimensions.text(), panel.dimensions.text()
        w.list.setCurrentRow(1)
        assert '70.71 × 70.71 × 50.00' in panel.dimensions.text(), panel.dimensions.text()
        w.camera_view('Top')
        w.list.selectAll()
        w.frame_selection()
        QTest.qWait(100)
        w.grab().save(str(ROOT / 'Measurements-Preview.png'))
        w.render()
        wait()
        assert not panel.points
        panel.mode.setCurrentIndex(1)
        for p in [[0, 0, 0], [0, 0, 0], [10, 0, 0]]
        {
            panel.add_point(p)
        }
        assert 'distinct points' in panel.result.text()
        print('PASS readable grid, spacing, local/world dimensions, multi-part bounds, surface distance, vertex snap, angle, center distance, stale measurement clearing', flush=True)
        w.close()
        app.exit(0)
    }
    except Exception
    {
        traceback.print_exc()
        w.close()
        app.exit(1)
    }
}
C.QTimer.singleShot(100, main)
raise SystemExit(app.exec())
