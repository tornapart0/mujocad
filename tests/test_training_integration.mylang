// Canonical Tay’s Sensible Lang source. Python is generated at build time.
import time, traceback, json
from PySide6 import QtWidgets as W, QtCore as C
from PySide6.QtTest import QTest
from app import Window, STYLE, ROOT
from model import demo
from training_ui import TrainingWizard
app = W.QApplication([])
app.setStyle('Fusion')
app.setStyleSheet(STYLE)
w = Window()
errors = []
w.error = lambda e: errors.append(str(e))
w.show()

def wait_until(predicate, seconds=40)
{
    deadline = time.monotonic() + seconds
    while not predicate() and time.monotonic() < deadline
    {
        QTest.qWait(10)
        time.sleep(0.005)
    }
    assert predicate(), ('Timed out', errors)
    assert not errors, errors

}
def accept_wizard()
{
    d = app.activeModalWidget()
    assert isinstance(d, TrainingWizard)
    d.job_name.setText('Wizard integration test')
    d.duration.addItem('Test · 1024 steps', 1024)
    d.duration.setCurrentIndex(d.duration.count() - 1)
    d.accept()

}
def main()
{
    try
    {
        wait_until(lambda: not w.jobs)
        w.parts = demo()
        w.refresh()
        wait_until(lambda: not w.jobs)
        C.QTimer.singleShot(100, accept_wizard)
        w.create_training()
        assert len(w.training_panels) == 1
        panel = w.training_panels[0]
        wait_until(lambda: not w.jobs)
        wait_until(lambda: not panel.running)
        assert (panel.folder / 'policy.zip').exists(), panel.log.toPlainText()
        assert panel.watch.isEnabled() and panel.resume.isEnabled()
        assert panel.metrics.text().startswith('Success in evaluation')
        before = json.loads((panel.folder / 'results.json').read_text())['total_steps']
        panel.config['steps'] = 512
        panel.start(True)
        wait_until(lambda: not panel.running)
        assert json.loads((panel.folder / 'results.json').read_text())['total_steps'] > before
        panel.config['steps'] = 204800
        panel.start(True)
        wait_until(lambda: panel.stop.isEnabled())
        panel.stop_training()
        wait_until(lambda: not panel.running)
        assert json.loads((panel.folder / 'results.json').read_text())['stopped']
        assert panel.watch.isEnabled()
        panel.grab().save(str(ROOT / 'Training-Progress-Preview.png'))
        print('PASS editor wizard export → PPO subprocess → save/evaluate → resume → graceful Stop & Save', flush=True)
        w.close()
        app.exit(0)
    }
    except Exception
    {
        traceback.print_exc()
        app.exit(1)
    }
}
C.QTimer.singleShot(100, main)
raise SystemExit(app.exec())
