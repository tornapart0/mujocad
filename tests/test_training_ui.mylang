// Canonical Tay’s Sensible Lang source. Python is generated at build time.
import time, traceback, json
from PySide6 import QtWidgets as W, QtCore as C
from PySide6.QtTest import QTest
from app import Window, STYLE, ROOT
from model import demo
from training_ui import TrainingWizard
app = W.QApplication([])
app.setStyle('Fusion')
app.setStyleSheet(STYLE)
w = Window()
errors = []
w.error = lambda e: errors.append(str(e))
w.show()

def wait()
{
    deadline = time.monotonic() + 20
    while w.jobs and time.monotonic() < deadline
    {
        QTest.qWait(10)
        time.sleep(0.01)
    }
    assert not w.jobs and (not errors), (w.jobs, errors)

}
def main()
{
    try
    {
        wait()
        wizard = TrainingWizard(demo(), w)
        wizard.show()
        QTest.qWait(50)
        assert wizard.controls_valid()
        assert wizard.button(W.QWizard.NextButton).isEnabled()
        wizard.next()
        assert wizard.currentId() == 1 and wizard.target_valid()
        assert wizard.pose_fields['arm'].value() == 30
        wizard.grab().save(str(ROOT / 'Training-Wizard-Preview.png'))
        wizard.next()
        assert wizard.currentId() == 2
        config = wizard.configuration()
        assert config['motors'] == ['arm_motor']
        assert abs(config['joint_targets']['arm_joint'] - 0.5235987756) < 1e-07
        wizard.back()
        wizard.back()
        wizard.goal.setCurrentIndex(1)
        wizard.next()
        assert wizard.target_valid()
        config = wizard.configuration()
        assert config['goal'] == 'reach' and len(config['target']) == 3
        wizard.tip.setCurrentText('base')
        assert not wizard.target_valid()
        wizard.tip.setCurrentText('arm')
        assert wizard.target_valid()
        wizard.close()
        w.close()
        print('PASS training wizard navigation, pose defaults, motor selection, reachable suggestion, fixed-part rejection', flush=True)
        app.exit(0)
    }
    except Exception
    {
        traceback.print_exc()
        app.exit(1)
    }
}
C.QTimer.singleShot(100, main)
raise SystemExit(app.exec())
