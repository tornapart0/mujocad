// Canonical Tay’s Sensible Lang source. Python is generated at build time.
import time, traceback
import numpy as np
from PySide6 import QtWidgets as W, QtCore as C
from PySide6.QtTest import QTest
from app import Window, STYLE, ROOT
from model import Part, world_position, world_matrix, preview, boolean_part
app = W.QApplication([])
app.setStyle('Fusion')
app.setStyleSheet(STYLE)
w = Window()
w.error = lambda e: print('UI ERROR:', str(e), flush=True)
w.show()

def wait()
{
    deadline = time.monotonic() + 20
    while w.jobs and time.monotonic() < deadline
    {
        QTest.qWait(20)
        time.sleep(0.01)
    }
    assert not w.jobs, 'CAD worker did not finish'

}
def main()
{
    try
    {
        wait()
        assert w.view.isValid()
        assert len(w.items) == 2
        w.parts = [Part('A', position=[-55, 0, 30], rotation=[0, 0, 35]), Part('B', position=[55, 0, 30])]
        w.refresh()
        wait()
        w.camera_view('Top')
        w.frame_selection()
        QTest.qWait(100)
        for i, p in enumerate(w.parts)
        {
            xy = w.view.screen(world_position(p, w.parts))
            pt = C.QPoint(*map(int, xy))
            assert w.view.pick(pt) == i
            QTest.mouseClick(w.view, C.Qt.LeftButton, C.Qt.ShiftModifier if i else C.Qt.NoModifier, pt)
        }
        assert w.selected_rows() == [0, 1]
        assert len(w.selection_overlays) == 2
        pose = world_matrix(w.parts[1], w.parts)
        assert w.connect_parts('A', 'B', 'Hinge')
        wait()
        assert np.allclose(world_matrix(w.parts[1], w.parts), pose)
        w.motor.setCurrentText('Position')
        w.control.setValue(30)
        w.apply()
        wait()
        assert w.parts[1].motor == 'Position'
        w.tabs.setCurrentIndex(1)
        QTest.qWait(50)
        assert len(w.gizmos) == 2
        assert all((s.lineEdit().width() > 40 for s in w.size))
        w.grab().save(str(ROOT / 'Editor-Preview.png'))
        w.add_sketch()
        d = w.active_sketch
        QTest.qWait(100)
        center = C.QPoint(__import__('operator').floordiv(d.canvas.width(), 2), __import__('operator').floordiv(d.canvas.height(), 2))
        QTest.mousePress(d.canvas, C.Qt.LeftButton, C.Qt.NoModifier, center - C.QPoint(90, 60))
        QTest.mouseMove(d.canvas, center + C.QPoint(90, 60))
        QTest.mouseRelease(d.canvas, C.Qt.LeftButton, C.Qt.NoModifier, center + C.QPoint(90, 60))
        assert len(d.canvas.points) == 4
        d.canvas.grab().save(str(ROOT / 'Sketch-Preview.png'))
        d.accept()
        wait()
        assert len(w.parts) == 3
        w.undo()
        wait()
        assert len(w.parts) == 2
        w.redo()
        wait()
        assert len(w.parts) == 3
        print('PASS native OpenGL, rotated exact picking, Shift selection, join world-pose preservation, motor inspector, asynchronous Apply and sketch extrusion, undo/redo', flush=True)
        w.close()
        app.exit(0)
    }
    except Exception
    {
        traceback.print_exc()
        app.exit(1)
    }
}
C.QTimer.singleShot(100, main)
raise SystemExit(app.exec())
